<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title><%= supplier.name %> - <%= shopName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <% var active = 'suppliers' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1><%= supplier.name %></h1>
        <p>بيانات المورد والتشغيلات المستلمة منه</p>
      </div>
      <a href="/suppliers" class="btn-ghost-sm">← رجوع لقائمة الموردين</a>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (ok) { %><div class="alert alert-success"><%= ok %></div><% } %>

    <div class="stat-grid">
      <div class="stat-card"><div class="label">إجمالي الفواتير</div><div class="value mono"><%= Number(balance.total_invoiced).toFixed(2) %> ج.م</div><div class="sub"><%= balance.invoices_count %> فاتورة</div></div>
      <div class="stat-card"><div class="label">المدفوع</div><div class="value mono"><%= Number(balance.total_paid).toFixed(2) %> ج.م</div></div>
      <div class="stat-card"><div class="label">المستحق للمورد</div><div class="value err mono"><%= Number(balance.balance_due).toFixed(2) %> ج.م</div><% if (Number(balance.overdue_due) > 0) { %><div class="sub" style="color:var(--danger)">منه متأخر: <%= Number(balance.overdue_due).toFixed(2) %></div><% } %></div>
    </div>

    <div class="two-col">
      <div class="card">
        <h2>فواتير الشراء</h2>
        <a href="/purchases/new?supplier=<%= supplier.id %>" class="btn btn-sm">➕ فاتورة شراء جديدة</a>
        <% if (invoices.length === 0) { %>
          <div class="empty-state">مفيش فواتير شراء لسه</div>
        <% } else { %>
          <table>
            <thead><tr><th>#</th><th>رقم المورد</th><th>التاريخ</th><th>الإجمالي</th><th>المتبقي</th><th>الحالة</th></tr></thead>
            <tbody>
              <% invoices.forEach(i => { %>
                <tr>
                  <td class="mono" data-label="#"><a href="/purchases/<%= i.id %>" style="color:var(--accent)"><%= i.id %></a></td>
                  <td data-label="رقم المورد"><%= i.invoice_number || '—' %></td>
                  <td class="mono" data-label="التاريخ"><%= new Date(i.invoice_date).toLocaleDateString('ar-EG') %></td>
                  <td class="mono" data-label="الإجمالي"><%= Number(i.total_amount).toFixed(2) %></td>
                  <td class="mono" data-label="المتبقي"><%= i.status === 'cancelled' ? '—' : Number(i.remaining).toFixed(2) %></td>
                  <td data-label="الحالة">
                    <% if (i.status === 'cancelled') { %><span class="badge badge-ignored">ملغاة</span>
                    <% } else if (Number(i.remaining) === 0) { %><span class="badge badge-matched">مدفوعة</span>
                    <% } else if (i.overdue) { %><span class="badge badge-ignored">متأخرة</span>
                    <% } else { %><span class="badge badge-pending">مستحقة</span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="card">
        <h2>دفعة على الحساب</h2>
        <p style="color:var(--text-muted); font-size:13px;">المبلغ بيتوزع تلقائيًا على أقدم الفواتير المستحقة. لدفع فاتورة بعينها افتحها من القائمة.</p>
        <form action="/suppliers/<%= supplier.id %>/pay" method="POST">
          <div class="form-grid">
            <div class="field"><label>المبلغ</label><input type="number" step="0.01" min="0.01" name="amount" required max="<%= Number(balance.balance_due).toFixed(2) %>"></div>
            <div class="field"><label>الطريقة</label>
              <select name="method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option><option value="other">أخرى</option></select></div>
          </div>
          <div class="field"><label>ملاحظة</label><input type="text" name="note" maxlength="300"></div>
          <button type="submit" class="btn" <%= Number(balance.balance_due) <= 0 ? 'disabled' : '' %>>تسجيل الدفعة</button>
        </form>

        <h3 class="section-title" style="margin-top:20px;">آخر الدفعات</h3>
        <% if (payments.length === 0) { %>
          <div class="empty-state">مفيش دفعات</div>
        <% } else { %>
          <table>
            <thead><tr><th>التاريخ</th><th>المبلغ</th><th>الطريقة</th><th>الفاتورة</th></tr></thead>
            <tbody>
              <% payments.forEach(p => { %>
                <tr>
                  <td class="mono" data-label="التاريخ"><%= new Date(p.created_at).toLocaleDateString('ar-EG') %></td>
                  <td class="mono" data-label="المبلغ"><%= Number(p.amount).toFixed(2) %></td>
                  <td data-label="الطريقة"><%= {cash:'نقدي', bank:'بنكي', other:'أخرى'}[p.method] %></td>
                  <td data-label="الفاتورة"><a href="/purchases/<%= p.invoice_id %>" style="color:var(--accent)">#<%= p.invoice_id %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="two-col">
      <div class="card">
        <h2>بيانات المورد</h2>
        <div class="field"><label>الهاتف</label><div><%= supplier.phone || '-' %></div></div>
        <div class="field"><label>العنوان</label><div><%= supplier.address || '-' %></div></div>
        <div class="field"><label>ملاحظات</label><div><%= supplier.notes || '-' %></div></div>

        <div class="stat-grid" style="grid-template-columns: 1fr; margin-top:16px;">
          <div class="stat-card">
            <div class="label">إجمالي قيمة البضاعة المستلمة</div>
            <div class="value accent"><%= Number(totalPurchased).toFixed(2) %> ج.م</div>
            <div class="sub"><%= batches.length %> تشغيلة</div>
          </div>
        </div>

        <h3 class="section-title" style="margin-top:20px;">تعديل بيانات المورد</h3>
        <form action="/suppliers/<%= supplier.id %>/update" method="POST">
          <div class="field">
            <label>اسم المورد</label>
            <input type="text" name="name" value="<%= supplier.name %>" required>
          </div>
          <div class="field">
            <label>الهاتف</label>
            <input type="text" name="phone" value="<%= supplier.phone || '' %>">
          </div>
          <div class="field">
            <label>العنوان</label>
            <input type="text" name="address" value="<%= supplier.address || '' %>">
          </div>
          <div class="field">
            <label>ملاحظات</label>
            <textarea name="notes" rows="2"><%= supplier.notes || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-sm">حفظ التعديلات</button>
        </form>
      </div>

      <div class="card">
        <h2>التشغيلات المستلمة من هذا المورد</h2>
        <% if (batches.length === 0) { %>
          <div class="empty-state">لسه مفيش تشغيلات مستلمة من المورد ده</div>
        <% } else { %>
          <table>
            <thead>
              <tr><th>الصنف</th><th>رقم التشغيلة</th><th>الكمية المستلمة</th><th>سعر التكلفة</th><th>تاريخ الاستلام</th></tr>
            </thead>
            <tbody>
              <% batches.forEach(b => { %>
                <tr>
                  <td data-label="الصنف"><%= b.medicine_name %></td>
                  <td class="mono" style="color:var(--text-muted); font-size:12px;" data-label="رقم التشغيلة"><%= b.batch_number || '—' %></td>
                  <td class="mono" data-label="الكمية المستلمة"><%= b.received_units %></td>
                  <td class="mono" data-label="سعر التكلفة"><%= Number(b.cost_price_unit).toFixed(2) %></td>
                  <td class="mono" style="color:var(--text-muted)" data-label="تاريخ الاستلام"><%= new Date(b.received_at).toLocaleDateString('ar-EG') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
        <p style="color:var(--text-muted); font-size:13px; margin-top:12px;">
          لاستلام بضاعة من هذا المورد سجّل <a href="/purchases/new?supplier=<%= supplier.id %>" style="color:var(--accent)">فاتورة شراء</a> (الأفضل، بتحسب المديونية). الاستلام السريع بدون فاتورة لسه متاح من <a href="/products/batches" style="color:var(--accent)">التشغيلات والصلاحية</a>.
        </p>
      </div>
    </div>
  </div>
</body>
</html>
