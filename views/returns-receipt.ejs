<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>إيصال استرجاع #<%= ret.id %></title>
  <style>
    body { font-family: Tahoma, Arial, sans-serif; max-width: 420px; margin: 20px auto; padding: 16px; color: #fff; background-color: #0f1117; }
    .card { background-color: #1a202c; border: 1px solid #2d3748; border-radius: 8px; padding: 20px; }
    h1 { font-size: 18px; text-align: center; margin-bottom: 4px; color: #fff; }
    .sub { text-align: center; color: #a0aec0; font-size: 12px; margin-bottom: 15px; }
    
    table { width: 100%; border-collapse: collapse; margin-top: 12px; background-color: #1a202c; color: #fff; text-align: right; }
    th, td { padding: 10px; border-bottom: 1px solid #2d3748; font-size: 14px; }
    th { color: #a0aec0; background-color: #2d3748; font-size: 12px; }
    
    .total { 
      font-weight: bold; 
      font-size: 16px; 
      margin-top: 20px; 
      text-align: center; 
      background-color: #2d3748;
      border: 1px solid #4a5568;
      padding: 12px;
      border-radius: 6px;
      color: #48bb78;
    }

    .btn-print { 
      display: block; 
      width: 100%; 
      margin-top: 18px; 
      padding: 10px; 
      text-align: center; 
      background: #4299e1; 
      color: #fff; 
      border: none; 
      border-radius: 6px; 
      cursor: pointer; 
      font-size: 14px; 
      font-weight: bold;
    }
    .btn-print:hover { background: #3182ce; }

    /* استجابة الموبايل بنفس نمط كود الورديات باستخدام data-label */
    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr {
        display: block !important;
        width: 100% !important;
      }
      thead { display: none !important; }
      tr {
        background-color: #1a202c !important;
        border: 1px solid #2d3748 !important;
        border-radius: 8px;
        margin-bottom: 10px;
        padding: 6px 10px;
      }
      td {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        padding: 10px !important;
        border-bottom: 1px solid #2d3748 !important;
      }
      td:last-child { border-bottom: none !important; }
      td::before {
        content: attr(data-label);
        font-weight: bold;
        color: #a0aec0;
      }
    }

    @media print {
      body { background: #fff !important; color: #111 !important; max-width: none; padding: 0; }
      .card { border: none; background: #fff !important; padding: 0; }
      .btn-print { display: none !important; }
      .total { background: none !important; color: #111 !important; border: 2px solid #111 !important; }
      table, tr, td { background: #fff !important; color: #111 !important; border-color: #ccc !important; }
      td::before { color: #666 !important; }
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>إيصال استرجاع</h1>
    <div class="sub">رقم #<%= ret.id %></div>
    
    <table class="table table-bordered table-striped">
      <thead>
        <tr>
          <th>البيان</th>
          <th>التفاصيل</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="التاريخ">التاريخ</td>
          <td data-label="التفاصيل"><%= new Date(ret.created_at).toLocaleString('ar-EG') %></td>
        </tr>
        <tr>
          <td data-label="الصنف">الصنف</td>
          <td data-label="التفاصيل"><%= ret.medicine_name_snapshot %></td>
        </tr>
        <tr>
          <td data-label="الكمية">الكمية</td>
          <td data-label="التفاصيل"><%= ret.quantity %> <%= ret.unit_label || ({unit:'حبة',strip:'شريط',box:'علبة'})[ret.sale_unit] || ret.sale_unit %></td>
        </tr>
        <tr>
          <td data-label="السبب">السبب</td>
          <td data-label="التفاصيل"><%= ret.reason || '-' %></td>
        </tr>
        <tr>
          <td data-label="رجعت للمخزون؟">رجعت للمخزون؟</td>
          <td data-label="التفاصيل"><%= ret.restocked ? 'آه' : 'لأ' %></td>
        </tr>
        <% if (ret.customer_name) { %>
        <tr>
          <td data-label="العميل">العميل</td>
          <td data-label="التفاصيل"><%= ret.customer_name %></td>
        </tr>
        <% } %>
      </tbody>
    </table>

    <div class="total">المبلغ المرجّع: <%= Number(ret.refund_amount).toFixed(2) %> ج.م</div>
    <button class="btn-print" onclick="window.print()">🖨 طباعة الإيصال</button>
  </div>
</body>
</html>
