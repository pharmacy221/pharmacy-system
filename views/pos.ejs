<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>الكاشير - <%= shopName %></title>
  <%- include('partials/head') %>
  <style>
    .pos-layout {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 20px;
      align-items: start;
    }

    .cart-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    .cart-table th {
      background: rgba(0, 217, 163, 0.15);
      padding: 10px 8px;
      font-size: 13px;
      color: var(--accent);
      border-bottom: 2px solid rgba(0, 217, 163, 0.3);
      text-align: right;
    }

    .cart-table td {
      padding: 10px 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      vertical-align: middle;
      font-size: 14px;
    }

    .cart-item-title { font-weight: 700; color: inherit; }
    .cart-item-unit {
      display: inline-block;
      font-size: 11px;
      background: rgba(255, 255, 255, 0.1);
      color: #94a3b8;
      padding: 2px 6px;
      border-radius: 4px;
      margin-top: 4px;
    }
    .cart-item-rx { color: var(--amber); font-size: 11px; }

    .cart-qty-controls { display: flex; align-items: center; gap: 6px; }
    .cart-qty-controls button {
      width: 26px; height: 26px;
      border: 1px solid var(--accent);
      background: rgba(0, 217, 163, 0.15);
      color: var(--accent);
      border-radius: 4px; cursor: pointer; font-weight: bold;
    }

    .summary-section { margin-top: 15px; border-top: 2px dashed rgba(255,255,255,0.15); padding-top: 12px; }
    .summary-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:15px; }
    .summary-row.total-final { margin-top:10px; padding-top:8px; border-top:1px solid rgba(255,255,255,0.1); }
    .summary-row.total-final .label { font-size:18px; font-weight:700; }
    .summary-row.total-final .value { font-size:22px; font-weight:800; color: var(--accent); }
    .summary-row.discount-row .value { color: var(--danger); }

    .discount-group { display:flex; gap:8px; }
    .discount-group input { flex:1; }
    .discount-group select { width:90px; }

    .coupon-group { display:flex; gap:8px; }
    .coupon-group input { flex:1; text-transform: uppercase; }
    .coupon-group button {
      white-space:nowrap; background: rgba(0,217,163,0.15);
      border:1px solid var(--accent); color: var(--accent);
      border-radius:6px; padding:0 14px; cursor:pointer; font-weight:600;
    }
    .coupon-status { font-size:12px; margin-top:6px; }
    .coupon-status.ok { color: var(--accent); }
    .coupon-status.err { color: var(--danger); }

    .keyboard-shortcuts-hint { display:flex; gap:12px; font-size:12px; color:var(--text-muted); margin-top:8px; flex-wrap: wrap; }
    .keyboard-shortcuts-hint kbd {
      background: rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2);
      border-radius:3px; padding:1px 5px; color: var(--accent); font-family: monospace;
    }

    @media (max-width: 900px) {
      .pos-layout { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <% var active = 'pos' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>الكاشير</h1>
        <p>امسح الباركود أو ابحث بالاسم لإضافة الأصناف وتسجيل الفاتورة</p>
        <div class="keyboard-shortcuts-hint">
          <span><kbd>F2</kbd> مسح باركود</span>
          <span><kbd>F4</kbd> بحث بالاسم</span>
          <span><kbd>Ctrl+Enter</kbd> إتمام البيع</span>
        </div>
      </div>
    </div>

    <% if (!activeShift) { %>
      <div class="alert alert-error">
        لازم تفتح وردية الأول قبل ما تقدر تبيع. <a href="/shifts" style="color:inherit; text-decoration:underline;">افتح وردية من هنا</a>
      </div>
    <% } %>

    <div class="pos-layout">
      <!-- البحث والسلة -->
      <div>
        <div class="card">
          <h2>إضافة صنف</h2>
          <div class="scan-box">
            <input type="text" id="barcodeInput" placeholder="امسح الباركود هنا... (F2)" autofocus autocomplete="off">
            <button type="button" class="btn-cam" id="openCameraBtn" title="مسح بالكاميرا">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            </button>
          </div>
          <div id="scanStatus" class="scan-status"></div>

          <div id="cameraModal" class="camera-modal" style="display:none;">
            <div class="camera-modal-inner">
              <div class="camera-modal-header">
                <span>وجّه الكاميرا على الباركود</span>
                <button type="button" id="closeCameraBtn" class="btn-ghost-sm">إغلاق</button>
              </div>
              <div id="cameraReader"></div>
              <div id="cameraScanStatus" class="scan-status"></div>
            </div>
          </div>

          <div class="search-results" style="margin-top:12px;">
            <input type="text" id="searchInput" placeholder="أو ابحث باسم الصنف / الاسم العلمي... (F4)" autocomplete="off">
            <div id="searchDropdown" class="search-dropdown" style="display:none;"></div>
          </div>
        </div>

        <div class="card" style="margin-top: 16px;">
          <h2>سلة الأصناف</h2>
          <table class="cart-table" id="cartTable">
            <thead>
              <tr>
                <th>الصنف</th>
                <th>الوحدة</th>
                <th style="text-align:center;">السعر</th>
                <th style="text-align:center;">الكمية</th>
                <th style="text-align:left;">الإجمالي</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="cartBody">
              <tr id="emptyCartRow"><td colspan="6" style="text-align:center; color:var(--text-muted); padding:20px;">السلة فارغة</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ملخص الفاتورة والدفع -->
      <div class="card">
        <h2>إتمام البيع</h2>

        <div class="field">
          <label>اسم العميل (اختياري)</label>
          <input type="text" id="customerName" placeholder="اسم العميل">
        </div>
        <div class="field">
          <label>تليفون العميل (اختياري)</label>
          <input type="text" id="customerPhone" placeholder="01xxxxxxxxx">
        </div>

        <div class="field">
          <label>طريقة الدفع</label>
          <select id="paymentMethod">
            <option value="cash">كاش</option>
            <option value="card">بطاقة</option>
            <option value="other">أخرى</option>
          </select>
        </div>

        <div class="field">
          <label>الخصم اليدوي</label>
          <div class="discount-group">
            <input type="number" id="discountValue" value="0" min="0" step="0.01">
            <select id="discountType">
              <option value="amount">ج.م</option>
              <option value="percent">%</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label>كود الكوبون (اختياري)</label>
          <div class="coupon-group">
            <input type="text" id="couponInput" placeholder="مثال: SAVE10">
            <button type="button" id="applyCouponBtn">تطبيق</button>
          </div>
          <div id="couponStatus" class="coupon-status"></div>
        </div>

        <div class="field">
          <label>ملاحظات (اختياري)</label>
          <textarea id="notes" rows="2"></textarea>
        </div>

        <div class="summary-section">
          <div class="summary-row">
            <span class="label">المجموع الفرعي</span>
            <span class="value mono" id="cartSubtotal">0.00 ج.م</span>
          </div>
          <div class="summary-row discount-row">
            <span class="label">إجمالي الخصم</span>
            <span class="value mono" id="cartDiscount">0.00 ج.م</span>
          </div>
          <div class="summary-row total-final">
            <span class="label">الإجمالي النهائي</span>
            <span class="value mono" id="cartTotal">0.00 ج.م</span>
          </div>
        </div>

        <div id="checkoutError" class="alert alert-error" style="display:none; margin-top:10px;"></div>
        <button type="button" id="checkoutBtn" class="btn" style="width:100%; margin-top:10px;" <%= !activeShift ? 'disabled' : '' %>>
          تسجيل البيع وطباعة الفاتورة (Ctrl+Enter)
        </button>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    const hasActiveShift = <%= activeShift ? 'true' : 'false' %>;

    function playBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = 1200;
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.15);
        osc.onended = () => ctx.close();
      } catch (err) { }
    }

    let cart = [];
    let appliedCoupon = null;

    const barcodeInput = document.getElementById('barcodeInput');
    const scanStatus = document.getElementById('scanStatus');
    const searchInput = document.getElementById('searchInput');
    const searchDropdown = document.getElementById('searchDropdown');
    const cartBody = document.getElementById('cartBody');
    const emptyCartRow = document.getElementById('emptyCartRow');
    const cartSubtotal = document.getElementById('cartSubtotal');
    const cartDiscount = document.getElementById('cartDiscount');
    const cartTotal = document.getElementById('cartTotal');
    const discountValueInput = document.getElementById('discountValue');
    const discountTypeSelect = document.getElementById('discountType');
    const couponInput = document.getElementById('couponInput');
    const applyCouponBtn = document.getElementById('applyCouponBtn');
    const couponStatus = document.getElementById('couponStatus');
    const checkoutBtn = document.getElementById('checkoutBtn');
    const checkoutError = document.getElementById('checkoutError');

    function showStatus(msg, type) {
      scanStatus.textContent = msg;
      scanStatus.className = 'scan-status ' + (type || '');
      setTimeout(() => { scanStatus.textContent = ''; }, 2500);
    }

    function unitPriceFor(medicine, saleUnit) {
      if (saleUnit === 'unit') return Number(medicine.sale_price_unit);
      if (saleUnit === 'strip') return Number(medicine.sale_price_strip || medicine.sale_price_unit * medicine.units_per_strip);
      return Number(medicine.sale_price_box || medicine.sale_price_unit * medicine.units_per_strip * medicine.strips_per_box);
    }

    function addToCart(medicine, saleUnit) {
      saleUnit = saleUnit || 'unit';
      const existing = cart.find(i => i.medicine_id === medicine.id && i.sale_unit === saleUnit);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          medicine_id: medicine.id,
          name: medicine.name,
          sale_unit: saleUnit,
          quantity: 1,
          units_per_strip: medicine.units_per_strip,
          strips_per_box: medicine.strips_per_box,
          sale_price_unit: medicine.sale_price_unit,
          sale_price_strip: medicine.sale_price_strip,
          sale_price_box: medicine.sale_price_box,
          requires_prescription: medicine.requires_prescription
        });
      }
      renderCart();
    }

    function renderCart() {
      if (cart.length === 0) {
        cartBody.innerHTML = '';
        cartBody.appendChild(emptyCartRow);
        updateSummary();
        return;
      }

      cartBody.innerHTML = cart.map((item, idx) => {
        const fakeMed = { sale_price_unit: item.sale_price_unit, sale_price_strip: item.sale_price_strip, sale_price_box: item.sale_price_box, units_per_strip: item.units_per_strip, strips_per_box: item.strips_per_box };
        const price = unitPriceFor(fakeMed, item.sale_unit);
        const lineTotal = price * item.quantity;
        return `
          <tr>
            <td>
              <div class="cart-item-title">${item.name}</div>
              ${item.requires_prescription ? '<div class="cart-item-rx">تحتاج روشتة</div>' : ''}
            </td>
            <td>
              <select onchange="changeUnit(${idx}, this.value)" style="width:auto; padding:4px;">
                <option value="unit" ${item.sale_unit === 'unit' ? 'selected' : ''}>حبة</option>
                <option value="strip" ${item.sale_unit === 'strip' ? 'selected' : ''}>شريط</option>
                <option value="box" ${item.sale_unit === 'box' ? 'selected' : ''}>علبة</option>
              </select>
            </td>
            <td class="mono" style="text-align:center;">${price.toFixed(2)}</td>
            <td style="text-align:center;">
              <div class="cart-qty-controls">
                <button type="button" onclick="changeQty(${idx}, 1)">+</button>
                <span class="mono">${item.quantity}</span>
                <button type="button" onclick="changeQty(${idx}, -1)">-</button>
              </div>
            </td>
            <td class="mono" style="text-align:left;">${lineTotal.toFixed(2)}</td>
            <td><button type="button" class="btn-ghost-sm" onclick="removeItem(${idx})">حذف</button></td>
          </tr>
        `;
      }).join('');

      updateSummary();
    }

    function changeUnit(idx, unit) {
      cart[idx].sale_unit = unit;
      renderCart();
    }

    function changeQty(idx, delta) {
      const item = cart[idx];
      const newQty = item.quantity + delta;
      if (newQty < 1) { removeItem(idx); return; }
      item.quantity = newQty;
      renderCart();
    }

    function removeItem(idx) {
      cart.splice(idx, 1);
      renderCart();
    }

    function updateSummary() {
      let subtotal = 0;
      cart.forEach(item => {
        const fakeMed = { sale_price_unit: item.sale_price_unit, sale_price_strip: item.sale_price_strip, sale_price_box: item.sale_price_box, units_per_strip: item.units_per_strip, strips_per_box: item.strips_per_box };
        subtotal += unitPriceFor(fakeMed, item.sale_unit) * item.quantity;
      });

      let discountVal = parseFloat(discountValueInput.value) || 0;
      let manualDiscount = discountTypeSelect.value === 'percent' ? (subtotal * discountVal) / 100 : discountVal;

      let couponDiscount = 0;
      if (appliedCoupon) {
        couponDiscount = Number(appliedCoupon.discount_amount) || 0;
      }

      const totalDiscount = Math.min(manualDiscount + couponDiscount, subtotal);
      const grandTotal = Math.max(0, subtotal - totalDiscount);

      cartSubtotal.textContent = subtotal.toFixed(2) + ' ج.م';
      cartDiscount.textContent = totalDiscount.toFixed(2) + ' ج.م';
      cartTotal.textContent = grandTotal.toFixed(2) + ' ج.م';
      cartTotal.dataset.rawTotal = grandTotal;
      cartSubtotal.dataset.rawSubtotal = subtotal;
    }

    discountValueInput.addEventListener('input', updateSummary);
    discountTypeSelect.addEventListener('change', updateSummary);

    async function lookupAndAdd(code, statusFn) {
      const report = statusFn || showStatus;
      if (!code) return;
      try {
        const res = await fetch('/pos/lookup?barcode=' + encodeURIComponent(code));
        const data = await res.json();
        if (data.found) {
          addToCart(data.medicine, 'unit');
          report('تمت إضافة: ' + data.medicine.name, 'ok');
        } else {
          report('لم يتم العثور على الصنف: ' + code, 'err');
        }
      } catch (err) {
        report('حدث خطأ في الاتصال بالسيرفر', 'err');
      }
    }

    barcodeInput.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const code = barcodeInput.value.trim();
      barcodeInput.value = '';
      await lookupAndAdd(code);
      barcodeInput.focus();
    });

    const openCameraBtn = document.getElementById('openCameraBtn');
    const closeCameraBtn = document.getElementById('closeCameraBtn');
    const cameraModal = document.getElementById('cameraModal');
    const cameraScanStatus = document.getElementById('cameraScanStatus');
    let html5QrCode = null;
    let cameraBusy = false;

    function showCameraStatus(msg, type) {
      cameraScanStatus.textContent = msg;
      cameraScanStatus.className = 'scan-status ' + (type || '');
    }

    async function startCamera() {
      if (typeof Html5Qrcode === 'undefined') {
        showStatus('تعذر تحميل مكتبة الكاميرا', 'err');
        return;
      }
      cameraModal.style.display = 'flex';
      html5QrCode = new Html5Qrcode('cameraReader');
      try {
        await html5QrCode.start(
          { facingMode: 'environment' },
          { fps: 10, qrbox: { width: 260, height: 160 } },
          async (decodedText) => {
            if (cameraBusy) return;
            cameraBusy = true;
            playBeep();
            showCameraStatus('جاري إضافة الصنف...', 'ok');
            await lookupAndAdd(decodedText.trim(), showStatus);
            await stopCamera();
          },
          () => { }
        );
      } catch (err) {
        showCameraStatus('تعذر فتح الكاميرا، يرجى السماح بالصلاحيات', 'err');
      }
    }

    async function stopCamera() {
      cameraModal.style.display = 'none';
      cameraBusy = false;
      if (html5QrCode) {
        try {
          const state = html5QrCode.getState ? html5QrCode.getState() : null;
          if (state === 2) await html5QrCode.stop();
          html5QrCode.clear();
        } catch (err) { }
        html5QrCode = null;
      }
      barcodeInput.focus();
    }

    openCameraBtn.addEventListener('click', startCamera);
    closeCameraBtn.addEventListener('click', stopCamera);

    let searchDebounce;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      const q = searchInput.value.trim();
      if (!q) { searchDropdown.style.display = 'none'; return; }
      searchDebounce = setTimeout(async () => {
        const res = await fetch('/pos/search?q=' + encodeURIComponent(q));
        const data = await res.json();
        if (data.results.length === 0) {
          searchDropdown.innerHTML = '<div class="item" style="color:var(--text-muted)">لا توجد نتائج</div>';
        } else {
          searchDropdown.innerHTML = data.results.map(m => `
            <div class="item" data-id="${m.id}">
              <span>${m.name} ${m.generic_name ? `<small style="color:var(--text-muted)">(${m.generic_name})</small>` : ''}</span>
              <span class="mono" style="color:var(--text-muted)">${Number(m.sale_price_unit).toFixed(2)} · متاح ${m.stock_units}</span>
            </div>
          `).join('');
        }
        searchDropdown.style.display = 'block';
        searchDropdown.querySelectorAll('.item[data-id]').forEach(el => {
          el.addEventListener('click', () => {
            const medicine = data.results.find(m => m.id == el.dataset.id);
            if (medicine) {
              addToCart(medicine, 'unit');
              showStatus('تمت إضافة: ' + medicine.name, 'ok');
            }
            searchInput.value = '';
            searchDropdown.style.display = 'none';
          });
        });
      }, 250);
    });

    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
        searchDropdown.style.display = 'none';
      }
    });

    applyCouponBtn.addEventListener('click', async () => {
      const code = couponInput.value.trim();
      if (!code) return;
      const subtotal = parseFloat(cartSubtotal.dataset.rawSubtotal) || 0;
      try {
        const res = await fetch('/pos/coupon-check?code=' + encodeURIComponent(code) + '&subtotal=' + subtotal);
        const data = await res.json();
        if (data.valid) {
          appliedCoupon = { code: data.coupon.code, discount_amount: data.discount_amount };
          couponStatus.textContent = 'تم تطبيق الكوبون: خصم ' + Number(data.discount_amount).toFixed(2) + ' ج.م';
          couponStatus.className = 'coupon-status ok';
        } else {
          appliedCoupon = null;
          couponStatus.textContent = data.message || 'كوبون غير صالح';
          couponStatus.className = 'coupon-status err';
        }
        updateSummary();
      } catch (err) {
        couponStatus.textContent = 'حصل خطأ أثناء التحقق من الكوبون';
        couponStatus.className = 'coupon-status err';
      }
    });

    async function doCheckout() {
      checkoutError.style.display = 'none';
      if (!hasActiveShift) {
        checkoutError.textContent = 'لازم تفتح وردية أولاً قبل إجراء عملية البيع';
        checkoutError.style.display = 'block';
        return;
      }
      if (cart.length === 0) {
        checkoutError.textContent = 'السلة فارغة، أضف صنفاً أولاً';
        checkoutError.style.display = 'block';
        return;
      }

      checkoutBtn.disabled = true;
      checkoutBtn.textContent = 'جاري التسجيل...';

      try {
        const res = await fetch('/pos/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cart.map(i => ({ medicine_id: i.medicine_id, sale_unit: i.sale_unit, quantity: i.quantity })),
            customer_name: document.getElementById('customerName').value,
            customer_phone: document.getElementById('customerPhone').value,
            payment_method: document.getElementById('paymentMethod').value,
            discount_amount: discountTypeSelect.value === 'percent'
              ? ((parseFloat(cartSubtotal.dataset.rawSubtotal) || 0) * (parseFloat(discountValueInput.value) || 0)) / 100
              : (parseFloat(discountValueInput.value) || 0),
            coupon_code: appliedCoupon ? appliedCoupon.code : null,
            notes: document.getElementById('notes').value
          })
        });
        const data = await res.json();
        if (data.ok) {
          window.location.href = '/pos/receipt/' + data.invoiceId;
        } else {
          checkoutError.textContent = data.error || 'حدث خطأ، يرجى المحاولة لاحقاً';
          checkoutError.style.display = 'block';
          checkoutBtn.disabled = false;
          checkoutBtn.textContent = 'تسجيل البيع وطباعة الفاتورة (Ctrl+Enter)';
        }
      } catch (err) {
        checkoutError.textContent = 'حدث خطأ في الاتصال بالسيرفر';
        checkoutError.style.display = 'block';
        checkoutBtn.disabled = false;
        checkoutBtn.textContent = 'تسجيل البيع وطباعة الفاتورة (Ctrl+Enter)';
      }
    }

    checkoutBtn.addEventListener('click', doCheckout);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'F2') { e.preventDefault(); barcodeInput.focus(); }
      if (e.key === 'F4') { e.preventDefault(); searchInput.focus(); }
      if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); doCheckout(); }
    });
  </script>
</body>
</html>
