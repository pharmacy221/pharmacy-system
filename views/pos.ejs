<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>الكاشير - <%= shopName %></title>
  <%- include('partials/head') %>
  <style>
    .pos { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; align-items: start; }
    .pos-side { position: sticky; top: 76px; }
    .pos .card { margin-bottom: 14px; padding: 16px; }

    /* ---- شريط البحث ---- */
    .searchbar { display: flex; gap: 8px; align-items: stretch; }
    .searchbar input#q {
      flex: 1; font-size: 18px; padding: 12px 16px; border-radius: 10px;
      background: var(--bg); border: 2px solid var(--accent); color: var(--text);
    }
    .searchbar input#q:focus { outline: none; box-shadow: 0 0 0 3px var(--accent-ring); }
    .btn-icon {
      width: 52px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-2);
      color: var(--accent); cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .searchmeta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-top: 8px; font-size: 12px; color: var(--text-muted); }
    .searchmeta label { display: flex; gap: 6px; align-items: center; cursor: pointer; }
    .searchmeta kbd { background: var(--surface-2); border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; color: var(--accent); font-family: var(--mono); }
    #status { font-weight: 700; min-height: 18px; }
    #status.ok { color: var(--accent); } #status.err { color: var(--danger); }

    /* ---- نتائج البحث ---- */
    .results-wrap { max-height: 330px; overflow: auto; margin-top: 12px; border: 1px solid var(--border); border-radius: 10px; display: none; }
    .results-head { display: none; justify-content: space-between; align-items: center; margin-top: 12px; padding: 8px 12px; background: var(--amber-dim); color: var(--amber); border-radius: 8px; font-size: 13px; }
    table.t { width: 100%; border-collapse: collapse; font-size: 14px; }
    table.t th { position: sticky; top: 0; background: var(--surface-2); color: var(--text-muted); font-size: 12px; padding: 8px 10px; text-align: right; z-index: 1; }
    table.t td { padding: 8px 10px; border-top: 1px solid var(--border); vertical-align: middle; }
    table.t tr.res { cursor: pointer; }
    table.t tr.res:hover, table.t tr.res.sel { background: var(--accent-softer); }
    table.t tr.res.out { opacity: .55; }
    .pname { font-weight: 700; }
    .psub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
    .tag { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); margin-inline-start: 6px; }
    .tag.form { color: var(--accent); border-color: var(--accent-dim); background: var(--accent-dim); }
    .tag.rx { color: var(--amber); border-color: var(--amber-dim); background: var(--amber-dim); }
    .stock-ok { color: var(--accent); font-weight: 700; } .stock-low { color: var(--amber); font-weight: 700; } .stock-out { color: var(--danger); font-weight: 700; }
    .lvl-btns { display: flex; gap: 6px; flex-wrap: wrap; }
    .lvl {
      border: 1px solid var(--accent); background: var(--accent-soft); color: var(--accent);
      border-radius: 8px; padding: 4px 10px; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; line-height: 1.3;
    }
    .lvl small { display: block; font-family: var(--mono); font-weight: 500; color: var(--text); font-size: 11px; }
    .lvl:hover { background: var(--accent); color: var(--on-accent); } .lvl:hover small { color: var(--on-accent); }
    .lvl:disabled { opacity: .35; cursor: not-allowed; }
    .link-btn { background: none; border: none; color: var(--amber); cursor: pointer; font-family: var(--sans); font-size: 12px; text-decoration: underline; }

    /* ---- السلة ---- */
    .cart-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .cart-title h2 { margin: 0; }
    #cartBody tr.sel-line { background: var(--accent-soft); box-shadow: inset -3px 0 0 var(--accent); }
    .qty { display: inline-flex; align-items: center; gap: 4px; }
    .qty button { width: 30px; height: 30px; border-radius: 6px; border: 1px solid var(--accent); background: var(--accent-soft); color: var(--accent); cursor: pointer; font-size: 16px; font-weight: 700; }
    .qty input { width: 52px; text-align: center; padding: 5px 2px; font-family: var(--mono); }
    select.unit-sel { width: auto; padding: 5px 8px; }
    .warn { color: var(--danger); font-size: 11px; }
    td.num, th.num { text-align: center; font-family: var(--mono); }

    /* ---- جنب الفاتورة ---- */
    .grand { background: var(--accent-dim); border: 1px solid var(--accent); border-radius: 12px; padding: 14px; text-align: center; margin-bottom: 12px; }
    .grand .lbl { font-size: 13px; color: var(--text-muted); }
    .grand .val { font-family: var(--mono); font-size: 34px; font-weight: 700; color: var(--accent); }
    .sumrow { display: flex; justify-content: space-between; font-size: 14px; margin: 5px 0; }
    .sumrow.disc .v { color: var(--danger); }
    .row2 { display: flex; gap: 8px; } .row2 > * { flex: 1; }
    .side .field { margin-bottom: 10px; } .side label { font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 4px; }
    .coupon-status { font-size: 12px; margin-top: 4px; } .coupon-status.ok { color: var(--accent); } .coupon-status.err { color: var(--danger); }
    .pay-tabs { display: flex; gap: 6px; }
    .pay-tabs button { flex: 1; padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface-2); color: var(--text); cursor: pointer; font-family: var(--sans); font-weight: 700; }
    .pay-tabs button.on { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
    .checkout { width: 100%; padding: 14px; font-size: 17px; margin-top: 10px; }
    .shift-warn { margin-bottom: 14px; }

    @media (max-width: 960px) { .pos { grid-template-columns: 1fr; } .pos-side { position: static; } }
  </style>
</head>
<body>
  <% var active = 'pos' %>
  <%- include('partials/nav') %>

  <div class="page">
    <% if (!activeShift) { %>
      <div class="alert alert-error shift-warn">
        لازم تفتح وردية الأول قبل ما تقدر تبيع. <a href="/shifts" style="color:inherit; text-decoration:underline;">افتح وردية من هنا</a>
      </div>
    <% } %>

    <div class="pos">
      <!-- ================= البحث + السلة ================= -->
      <div>
        <div class="card">
          <div class="searchbar">
            <input type="text" id="q" placeholder="ابحث بالاسم التجاري أو المادة الفعالة أو امسح الباركود..." autocomplete="off" autofocus>
            <button type="button" class="btn-icon" id="openCameraBtn" title="مسح بالكاميرا">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            </button>
          </div>
          <div class="searchmeta">
            <label><input type="checkbox" id="instock"> المتاح في المخزون فقط</label>
            <span data-sc-wrap="search"><kbd data-sc="search"></kbd> بحث</span>
            <span><kbd>↑</kbd><kbd>↓</kbd> تنقل</span>
            <span><kbd>Enter</kbd> إضافة</span>
            <span><kbd>Ctrl+Enter</kbd> <span data-sc-wrap="pos_checkout" style="display:inline"><kbd data-sc="pos_checkout"></kbd> </span>إتمام البيع</span>
            <span data-sc-wrap="pos_qty_up"><kbd data-sc="pos_qty_up"></kbd><kbd data-sc="pos_qty_down"></kbd> زيادة/تقليل الكمية</span>
            <span id="status"></span>
          </div>

          <div id="resultsHead" class="results-head"><span id="resultsHeadText"></span><button type="button" class="link-btn" id="backBtn">رجوع للبحث</button></div>
          <div id="resultsWrap" class="results-wrap">
            <table class="t">
              <thead><tr><th>الصنف</th><th>الشركة</th><th>المتاح</th><th>إضافة للفاتورة</th><th></th></tr></thead>
              <tbody id="resultsBody"></tbody>
            </table>
          </div>

          <div id="cameraModal" class="camera-modal" style="display:none;">
            <div class="camera-modal-inner">
              <div class="camera-modal-header">
                <span>وجّه الكاميرا على الباركود</span>
                <button type="button" id="closeCameraBtn" class="btn-ghost-sm">إغلاق</button>
              </div>
              <div id="cameraReader"></div>
              <div id="cameraScanStatus" class="scan-status"></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="cart-title">
            <h2>الفاتورة <span id="cartCount" style="color:var(--text-muted); font-size:13px;"></span></h2>
            <button type="button" class="link-btn" id="clearCartBtn">تفريغ الفاتورة</button>
          </div>
          <div style="overflow-x:auto;">
            <table class="t">
              <thead>
                <tr><th>الصنف</th><th>الوحدة</th><th class="num">السعر</th><th class="num">الكمية</th><th class="num">الإجمالي</th><th></th></tr>
              </thead>
              <tbody id="cartBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= الدفع ================= -->
      <div class="pos-side side">
        <div class="card">
          <div class="grand"><div class="lbl">الإجمالي المطلوب</div><div class="val" id="cartTotal">0.00</div></div>
          <div class="sumrow"><span>المجموع الفرعي</span><span class="mono" id="cartSubtotal">0.00</span></div>
          <div class="sumrow disc"><span>الخصم</span><span class="mono v" id="cartDiscount">0.00</span></div>

          <hr style="border:0; border-top:1px dashed var(--border); margin:12px 0;">

          <div class="field">
            <label>طريقة الدفع</label>
            <div class="pay-tabs" id="payTabs">
              <button type="button" data-v="cash" class="on">كاش</button>
              <button type="button" data-v="card">بطاقة</button>
              <button type="button" data-v="other">أخرى</button>
            </div>
          </div>

          <div class="field">
            <label>خصم يدوي</label>
            <div class="row2">
              <input type="number" id="discountValue" value="0" min="0" step="0.01">
              <select id="discountType" style="max-width:90px;"><option value="amount">ج.م</option><option value="percent">%</option></select>
            </div>
          </div>

          <div class="field">
            <label>كوبون</label>
            <div class="row2">
              <input type="text" id="couponInput" placeholder="SAVE10" style="text-transform:uppercase;">
              <button type="button" class="btn-ghost-sm" id="applyCouponBtn" style="max-width:80px;">تطبيق</button>
            </div>
            <div id="couponStatus" class="coupon-status"></div>
          </div>

          <div id="custChip" class="cust-chip" style="display:none;"></div>
          <div class="cust-suggest">
            <div class="row2">
              <div class="field"><label>اسم العميل</label><input type="text" id="customerName" placeholder="اختياري" autocomplete="off"></div>
              <div class="field"><label>التليفون</label><input type="text" id="customerPhone" placeholder="01xxxxxxxxx" autocomplete="off" dir="ltr"></div>
            </div>
            <div class="dropdown" id="custDropdown" style="display:none;"></div>
          </div>

          <div class="field" id="creditRow">
            <label style="display:flex; gap:8px; align-items:center; color:var(--text); cursor:pointer;">
              <input type="checkbox" id="creditToggle" style="width:auto;"> بيع آجل (على حساب العميل)
            </label>
            <div id="creditBox" style="display:none; margin-top:8px;">
              <label>المدفوع دلوقتي (ج.م)</label>
              <input type="number" id="paidNow" value="0" min="0" step="0.01">
              <div class="muted" id="creditInfo" style="font-size:12px; margin-top:6px;"></div>
            </div>
          </div>

          <div class="controlled-box" id="controlledBox" style="display:none;">
            <h4>🔒 صنف خاضع للرقابة — بيانات الصرف إجبارية</h4>
            <div class="field"><label>اسم المريض *</label><input type="text" id="ctrlPatient" maxlength="120"></div>
            <div class="row2">
              <div class="field"><label>الرقم القومي / الجواز *</label><input type="text" id="ctrlNid" maxlength="20" dir="ltr"></div>
              <div class="field"><label>رقم الروشتة *</label><input type="text" id="ctrlRx" maxlength="60"></div>
            </div>
            <div class="field" style="margin-bottom:0;"><label>اسم الطبيب</label><input type="text" id="ctrlDoctor" maxlength="120"></div>
          </div>
          <div class="field"><label>ملاحظات</label><textarea id="notes" rows="2"></textarea></div>

          <div id="checkoutError" class="alert alert-error" style="display:none; margin-top:6px;"></div>
          <button type="button" id="checkoutBtn" class="btn checkout" <%= !activeShift ? 'disabled' : '' %>>تسجيل البيع وطباعة الفاتورة</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    const hasActiveShift = <%= activeShift ? 'true' : 'false' %>;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const money = (n) => Number(n || 0).toFixed(2);

    let cart = [];            // { m, sale_unit, quantity }
    let activeIdx = -1;       // الصنف المحدد في الفاتورة (للاختصارات: زيادة/تقليل/حذف)
    let appliedCoupon = null;
    let results = [];
    let selIdx = -1;
    let payMethod = 'cash';
    let statusTimer;

    function showStatus(msg, type) {
      const el = $('status'); el.textContent = msg; el.className = type || '';
      clearTimeout(statusTimer); statusTimer = setTimeout(() => { el.textContent = ''; }, 2500);
    }
    function playBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator(), gain = ctx.createGain();
        osc.type = 'square'; osc.frequency.value = 1200;
        gain.gain.setValueAtTime(0.2, ctx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
        osc.connect(gain); gain.connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + 0.15);
        osc.onended = () => ctx.close();
      } catch (e) {}
    }

    // ---------- أسعار ووحدات ----------
    function levelPrice(m, key) {
      const ups = m.units_per_strip || 1, spb = m.strips_per_box || 1;
      if (key === 'unit') return Number(m.sale_price_unit);
      if (key === 'strip') return Number(m.sale_price_strip || m.sale_price_unit * ups);
      return Number(m.sale_price_box || m.sale_price_unit * ups * spb);
    }
    function levelQty(m, key) { const l = m.levels.find((x) => x.key === key); return l ? l.qty : 1; }
    function levelLabel(m, key) { const l = m.levels.find((x) => x.key === key); return l ? l.label : key; }

    // "3 علبة + 4 شريط + 2 حبة" / "12 حقنة"
    function stockText(m) {
      let left = Number(m.stock_units) || 0;
      if (left <= 0) return 'نفذ';
      const parts = [];
      [...m.levels].sort((a, b) => b.qty - a.qty).forEach((l) => {
        const n = Math.floor(left / l.qty);
        if (n > 0) { parts.push(n + ' ' + l.label); left -= n * l.qty; }
      });
      return parts.join(' + ');
    }
    function stockClass(m) {
      const s = Number(m.stock_units) || 0;
      return s <= 0 ? 'stock-out' : (s <= (m.min_stock_units || 0) ? 'stock-low' : 'stock-ok');
    }

    // ---------- البحث ----------
    let debounce, reqId = 0, altMode = false, shownQuery = '';
    $('q').addEventListener('input', () => {
      clearTimeout(debounce);
      const q = $('q').value.trim();
      if (!q) { hideResults(); return; }
      debounce = setTimeout(() => runSearch(q), 220);
    });
    $('instock').addEventListener('change', () => { const q = $('q').value.trim(); if (q) runSearch(q); });

    async function runSearch(q) {
      const my = ++reqId;
      try {
        const res = await fetch('/pos/search?q=' + encodeURIComponent(q) + ($('instock').checked ? '&instock=1' : ''));
        const data = await res.json();
        if (my !== reqId) return;
        altMode = false; shownQuery = q;
        showResults(data.results, null);
      } catch (e) { showStatus('حدث خطأ في الاتصال بالسيرفر', 'err'); }
    }

    async function showAlternatives(id) {
      try {
        const res = await fetch('/pos/alternatives?id=' + id);
        const data = await res.json();
        altMode = true;
        showResults(data.results, 'بدائل ' + (data.base || '') + ' (نفس المادة الفعالة)');
      } catch (e) { showStatus('تعذر تحميل البدائل', 'err'); }
    }
    $('backBtn').addEventListener('click', () => { altMode = false; const q = $('q').value.trim(); q ? runSearch(q) : hideResults(); $('q').focus(); });

    function hideResults() { results = []; selIdx = -1; $('resultsWrap').style.display = 'none'; $('resultsHead').style.display = 'none'; }

    function showResults(list, headText) {
      results = list; selIdx = list.length ? 0 : -1;
      $('resultsHead').style.display = headText ? 'flex' : 'none';
      $('resultsHeadText').textContent = headText || '';
      $('resultsWrap').style.display = 'block';
      renderResults();
    }

    function renderResults() {
      if (!results.length) {
        $('resultsBody').innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted); padding:18px;">لا توجد نتائج</td></tr>';
        return;
      }
      $('resultsBody').innerHTML = results.map((m, i) => {
        const out = Number(m.stock_units) <= 0;
        const btns = m.levels.map((l) =>
          `<button type="button" class="lvl" data-add="${i}" data-unit="${l.key}" ${out ? 'disabled' : ''}>${esc(l.label)}<small>${money(levelPrice(m, l.key))}</small></button>`
        ).join('');
        return `
          <tr class="res ${i === selIdx ? 'sel' : ''} ${out ? 'out' : ''}" data-row="${i}">
            <td>
              <div class="pname">${esc(m.name)}
                ${m.form_label ? `<span class="tag form">${esc(m.form_label)}</span>` : ''}
                ${m.requires_prescription ? '<span class="tag rx">روشتة</span>' : ''}
              </div>
              ${m.generic_name ? `<div class="psub">${esc(m.generic_name)}</div>` : ''}
            </td>
            <td style="font-size:12px; color:var(--text-muted);">${esc(m.manufacturer || '')}</td>
            <td class="${stockClass(m)}" style="font-size:13px;">${esc(stockText(m))}</td>
            <td><div class="lvl-btns">${btns}</div></td>
            <td>${m.generic_name && !altMode ? `<button type="button" class="link-btn" data-alt="${m.id}">بدائل</button>` : ''}</td>
          </tr>`;
      }).join('');
      const sel = $('resultsBody').querySelector('tr.sel');
      if (sel) sel.scrollIntoView({ block: 'nearest' });
    }

    $('resultsBody').addEventListener('click', (e) => {
      const alt = e.target.closest('[data-alt]');
      if (alt) { showAlternatives(alt.dataset.alt); return; }
      const add = e.target.closest('[data-add]');
      if (add) { addToCart(results[+add.dataset.add], add.dataset.unit); return; }
      const row = e.target.closest('tr[data-row]');
      if (row) { selIdx = +row.dataset.row; renderResults(); }
    });

    // ---------- السلة ----------
    function addToCart(m, unit) {
      if (!m) return;
      if (Number(m.stock_units) <= 0) { showStatus('الصنف نفذ من المخزون: ' + m.name, 'err'); return; }
      unit = unit || m.default_level;
      const ex = cart.find((i) => i.m.id === m.id && i.sale_unit === unit);
      if (ex) ex.quantity += 1; else cart.push({ m, sale_unit: unit, quantity: 1 });
      activeIdx = ex ? cart.indexOf(ex) : cart.length - 1; // آخر صنف اتضاف هو المحدد
      showStatus('تمت إضافة: ' + m.name, 'ok');
      renderCart();
    }

    function lineUnits(i) { return i.quantity * levelQty(i.m, i.sale_unit); }
    function totalUnitsFor(id) { return cart.filter((i) => i.m.id === id).reduce((s, i) => s + lineUnits(i), 0); }

    function renderCart() {
      $('cartCount').textContent = cart.length ? `(${cart.length} صنف)` : '';
      if (!cart.length) {
        $('cartBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:22px;">الفاتورة فارغة — ابحث عن صنف أو امسح الباركود</td></tr>';
        updateSummary(); return;
      }
      $('cartBody').innerHTML = cart.map((i, idx) => {
        const price = levelPrice(i.m, i.sale_unit);
        const over = totalUnitsFor(i.m.id) > Number(i.m.stock_units);
        const unitCell = i.m.levels.length > 1
          ? `<select class="unit-sel" data-unit-idx="${idx}">${i.m.levels.map((l) => `<option value="${l.key}" ${l.key === i.sale_unit ? 'selected' : ''}>${esc(l.label)}</option>`).join('')}</select>`
          : `<span class="tag form" style="margin:0;">${esc(i.m.levels[0].label)}</span>`;
        return `
          <tr class="${idx === activeLine() ? 'sel-line' : ''}">
            <td><div class="pname">${esc(i.m.name)}</div>
              ${i.m.requires_prescription ? '<div class="psub" style="color:var(--amber)">تحتاج روشتة</div>' : ''}
              ${over ? `<div class="warn">المتاح في المخزون: ${esc(stockText(i.m))}</div>` : ''}</td>
            <td>${unitCell}</td>
            <td class="num">${money(price)}</td>
            <td class="num"><div class="qty">
              <button type="button" data-q="${idx}" data-d="1">+</button>
              <input type="number" min="1" value="${i.quantity}" data-qin="${idx}">
              <button type="button" data-q="${idx}" data-d="-1">−</button></div></td>
            <td class="num">${money(price * i.quantity)}</td>
            <td><button type="button" class="btn-ghost-sm" data-del="${idx}">حذف</button></td>
          </tr>`;
      }).join('');
      updateSummary();
    }

    $('cartBody').addEventListener('click', (e) => {
      const q = e.target.closest('[data-q]');
      if (q) { activeIdx = +q.dataset.q; changeQty(+q.dataset.d); return; }
      const d = e.target.closest('[data-del]');
      if (d) { activeIdx = +d.dataset.del; removeActive(); return; }
      setActiveFromRow(e.target);
    });
    $('cartBody').addEventListener('focusin', (e) => setActiveFromRow(e.target));

    // ---------- الصنف المحدد في الفاتورة ----------
    function activeLine() {
      if (!cart.length) return -1;
      if (activeIdx < 0 || activeIdx >= cart.length) activeIdx = cart.length - 1;
      return activeIdx;
    }
    function markActive() {
      Array.from($('cartBody').children).forEach((tr, n) => tr.classList.toggle('sel-line', n === activeIdx));
      const tr = $('cartBody').children[activeIdx];
      if (tr && tr.scrollIntoView) tr.scrollIntoView({ block: 'nearest' });
    }
    function setActiveFromRow(el) {
      const tr = el.closest && el.closest('#cartBody tr');
      if (!tr || !cart.length) return;
      const n = Array.prototype.indexOf.call($('cartBody').children, tr);
      if (n >= 0 && n !== activeIdx) { activeIdx = n; markActive(); }
    }
    function changeQty(d) {
      const a = activeLine(); if (a < 0) return false;
      cart[a].quantity += d;
      if (cart[a].quantity < 1) { cart.splice(a, 1); activeIdx = Math.min(a, cart.length - 1); }
      renderCart(); markActive();
    }
    function removeActive() {
      const a = activeLine(); if (a < 0) return false;
      cart.splice(a, 1); activeIdx = Math.min(a, cart.length - 1);
      renderCart(); markActive();
    }
    function moveActive(d) {
      if (!cart.length) return false;
      activeIdx = Math.min(Math.max(activeLine() + d, 0), cart.length - 1);
      markActive();
    }
    $('cartBody').addEventListener('change', (e) => {
      if (e.target.dataset.unitIdx !== undefined) { cart[+e.target.dataset.unitIdx].sale_unit = e.target.value; renderCart(); }
      if (e.target.dataset.qin !== undefined) {
        const n = parseInt(e.target.value) || 1; cart[+e.target.dataset.qin].quantity = Math.max(n, 1); renderCart();
      }
    });
    $('clearCartBtn').addEventListener('click', () => { if (cart.length && confirm('تفريغ الفاتورة؟')) { cart = []; activeIdx = -1; appliedCoupon = null; $('couponStatus').textContent = ''; renderCart(); } });

    function subtotal() { return cart.reduce((s, i) => s + levelPrice(i.m, i.sale_unit) * i.quantity, 0); }
    function manualDiscount(sub) {
      const v = parseFloat($('discountValue').value) || 0;
      return $('discountType').value === 'percent' ? (sub * v) / 100 : v;
    }
    let selectedCustomer = null;
    function cartHasControlled() { return cart.some((i) => i.m.controlled_substance); }
    function refreshExtras() {
      $('controlledBox').style.display = cartHasControlled() ? 'block' : 'none';
      const on = $('creditToggle').checked;
      $('creditBox').style.display = on ? 'block' : 'none';
      if (on) {
        const total = parseFloat($('cartTotal').textContent) || 0;
        const paid = Math.max(parseFloat($('paidNow').value) || 0, 0);
        const credit = Math.max(0, total - paid);
        let txt = 'هيتسجّل على حساب العميل: ' + money(credit) + ' ج.م';
        if (selectedCustomer) txt += ' — متاح له ' + money(selectedCustomer.available_credit) + ' ج.م';
        else txt += ' — اختار العميل أو اكتب تليفونه';
        $('creditInfo').textContent = txt;
      }
    }
    $('creditToggle').addEventListener('change', refreshExtras);
    $('paidNow').addEventListener('input', refreshExtras);

    // ---------- العميل: بحث بالاسم/التليفون واختيار + تذكيرات الصرف ----------
    let custTimer = null;
    function clearCustomer() { selectedCustomer = null; $('custChip').style.display = 'none'; refreshExtras(); }
    function chooseCustomer(c) {
      selectedCustomer = c; $('customerName').value = c.name; $('customerPhone').value = c.phone || '';
      $('custDropdown').style.display = 'none';
      const chip = $('custChip'); chip.innerHTML = ''; chip.style.display = 'flex';
      const nm = document.createElement('strong'); nm.textContent = '👤 ' + c.name; chip.appendChild(nm);
      if (Number(c.balance) > 0) { const b = document.createElement('span'); b.className = 'pill bad'; b.textContent = 'عليه ' + money(c.balance) + ' ج.م'; chip.appendChild(b); }
      (c.refills || []).forEach((r) => {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'refill-chip';
        b.textContent = '🔔 ' + r.name + (r.days_overdue > 0 ? ' (متأخر)' : '');
        b.title = 'إضافة للفاتورة';
        b.addEventListener('click', async () => {
          try { const res = await fetch('/pos/search?q=' + encodeURIComponent(r.name)); const d = await res.json();
            const m = (d.results || []).find((x) => x.id === r.medicine_id) || (d.results || [])[0]; if (m) addToCart(m, m.default_level); } catch (e) {}
        });
        chip.appendChild(b);
      });
      const x = document.createElement('button'); x.type = 'button'; x.className = 'btn-ghost-sm'; x.textContent = '✕'; x.addEventListener('click', () => { clearCustomer(); }); chip.appendChild(x);
      refreshExtras();
    }
    function searchCustomers(q) {
      clearTimeout(custTimer);
      if (q.trim().length < 2) { $('custDropdown').style.display = 'none'; return; }
      custTimer = setTimeout(async () => {
        try {
          const r = await fetch('/customers/search?q=' + encodeURIComponent(q.trim())); const d = await r.json();
          const dd = $('custDropdown'); dd.innerHTML = '';
          (d.results || []).forEach((c) => {
            const b = document.createElement('button'); b.type = 'button';
            b.textContent = c.name + (c.phone ? ' — ' + c.phone : '') + (c.refills && c.refills.length ? '  🔔' : '') + (Number(c.balance) > 0 ? '  (عليه ' + money(c.balance) + ')' : '');
            b.addEventListener('click', () => chooseCustomer(c)); dd.appendChild(b);
          });
          dd.style.display = (d.results || []).length ? 'block' : 'none';
        } catch (e) { /* تجاهل */ }
      }, 220);
    }
    $('customerName').addEventListener('input', (e) => { if (selectedCustomer) clearCustomer(); searchCustomers(e.target.value); });
    $('customerPhone').addEventListener('input', (e) => { if (selectedCustomer) clearCustomer(); searchCustomers(e.target.value); });
    document.addEventListener('click', (e) => { if (!e.target.closest('.cust-suggest')) $('custDropdown').style.display = 'none'; });

    function updateSummary() {
      const sub = subtotal();
      const disc = Math.min(manualDiscount(sub) + (appliedCoupon ? Number(appliedCoupon.discount_amount) || 0 : 0), sub);
      $('cartSubtotal').textContent = money(sub);
      $('cartDiscount').textContent = money(disc);
      $('cartTotal').textContent = money(Math.max(0, sub - disc));
      refreshExtras();
    }
    $('discountValue').addEventListener('input', updateSummary);
    $('discountType').addEventListener('change', updateSummary);
    $('payTabs').addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      payMethod = b.dataset.v;
      $('payTabs').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    });

    // ---------- باركود ----------
    async function lookupAndAdd(code, report) {
      report = report || showStatus;
      try {
        const res = await fetch('/pos/lookup?barcode=' + encodeURIComponent(code));
        const data = await res.json();
        if (data.found) { addToCart(data.medicine, data.medicine.default_level); return true; }
        report('لم يتم العثور على الصنف: ' + code, 'err');
      } catch (e) { report('حدث خطأ في الاتصال بالسيرفر', 'err'); }
      return false;
    }

    $('q').addEventListener('keydown', async (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); if (results.length) { selIdx = Math.min(selIdx + 1, results.length - 1); renderResults(); } }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (results.length) { selIdx = Math.max(selIdx - 1, 0); renderResults(); } }
      else if (e.key === 'Escape') { $('q').value = ''; hideResults(); }
      else if (e.key === 'Enter' && !e.ctrlKey) {
        e.preventDefault();
        const code = $('q').value.trim();
        if (!code) return;
        // باركود (أرقام فقط): بحث مباشر
        if (/^\d{6,}$/.test(code)) {
          const ok = await lookupAndAdd(code);
          if (ok) { $('q').value = ''; hideResults(); }
          return;
        }
        clearTimeout(debounce);
        if (code === shownQuery && results.length && selIdx >= 0) {
          addToCart(results[selIdx]);
          $('q').value = ''; hideResults();
        } else {
          await runSearch(code);
        }
      }
    });

    // ---------- كاميرا ----------
    let html5QrCode = null, cameraBusy = false;
    function showCameraStatus(msg, type) { $('cameraScanStatus').textContent = msg; $('cameraScanStatus').className = 'scan-status ' + (type || ''); }
    async function startCamera() {
      if (typeof Html5Qrcode === 'undefined') { showStatus('تعذر تحميل مكتبة الكاميرا', 'err'); return; }
      $('cameraModal').style.display = 'flex';
      html5QrCode = new Html5Qrcode('cameraReader');
      try {
        await html5QrCode.start({ facingMode: 'environment' }, { fps: 10, qrbox: { width: 260, height: 160 } },
          async (text) => {
            if (cameraBusy) return; cameraBusy = true; playBeep();
            showCameraStatus('جاري إضافة الصنف...', 'ok');
            await lookupAndAdd(text.trim(), showStatus);
            await stopCamera();
          }, () => {});
      } catch (err) { showCameraStatus('تعذر فتح الكاميرا، يرجى السماح بالصلاحيات', 'err'); }
    }
    async function stopCamera() {
      $('cameraModal').style.display = 'none'; cameraBusy = false;
      if (html5QrCode) {
        try { const st = html5QrCode.getState ? html5QrCode.getState() : null; if (st === 2) await html5QrCode.stop(); html5QrCode.clear(); } catch (e) {}
        html5QrCode = null;
      }
      $('q').focus();
    }
    $('openCameraBtn').addEventListener('click', startCamera);
    $('closeCameraBtn').addEventListener('click', stopCamera);

    // ---------- كوبون ----------
    $('applyCouponBtn').addEventListener('click', async () => {
      const code = $('couponInput').value.trim(); if (!code) return;
      try {
        const res = await fetch('/pos/coupon-check?code=' + encodeURIComponent(code) + '&subtotal=' + subtotal());
        const data = await res.json();
        if (data.valid) {
          appliedCoupon = { code: data.coupon.code, discount_amount: data.discount_amount };
          $('couponStatus').textContent = 'تم تطبيق الكوبون: خصم ' + money(data.discount_amount) + ' ج.م'; $('couponStatus').className = 'coupon-status ok';
        } else {
          appliedCoupon = null; $('couponStatus').textContent = data.message || 'كوبون غير صالح'; $('couponStatus').className = 'coupon-status err';
        }
        updateSummary();
      } catch (e) { $('couponStatus').textContent = 'حصل خطأ أثناء التحقق من الكوبون'; $('couponStatus').className = 'coupon-status err'; }
    });

    // ---------- إتمام البيع ----------
    const CHECKOUT_LABEL = 'تسجيل البيع وطباعة الفاتورة';
    function fail(msg) { $('checkoutError').textContent = msg; $('checkoutError').style.display = 'block'; $('checkoutBtn').disabled = !hasActiveShift; $('checkoutBtn').textContent = CHECKOUT_LABEL; }
    // مفتاح منع تكرار البيع: نفس السلة + نفس الصفحة = نفس المفتاح، فلو الطلب اتبعت مرتين (ضغطة مزدوجة/انقطاع نت)
    // السيرفر يرجّع نفس الفاتورة بدل ما يبيع تاني. لو السلة اتغيرت المفتاح بيتغير.
    const PAGE_KEY = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now().toString(36) + Math.random().toString(36).slice(2));
    function hashStr(s) { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0; return (h >>> 0).toString(36); }
    async function doCheckout() {
      $('checkoutError').style.display = 'none';
      if (!hasActiveShift) return fail('لازم تفتح وردية أولاً قبل إجراء عملية البيع');
      if (!cart.length) return fail('الفاتورة فارغة، أضف صنفاً أولاً');
      $('checkoutBtn').disabled = true; $('checkoutBtn').textContent = 'جاري التسجيل...';
      try {
        const payload = {
          items: cart.map((i) => ({ medicine_id: i.m.id, sale_unit: i.sale_unit, quantity: i.quantity })),
          customer_name: $('customerName').value, customer_phone: $('customerPhone').value,
          payment_method: payMethod, discount_amount: manualDiscount(subtotal()),
          coupon_code: appliedCoupon ? appliedCoupon.code : null, notes: $('notes').value,
          customer_id: selectedCustomer ? selectedCustomer.id : null,
          credit: $('creditToggle').checked, paid_now: parseFloat($('paidNow').value) || 0
        };
        if (cartHasControlled()) {
          payload.controlled = { patient_name: $('ctrlPatient').value, national_id: $('ctrlNid').value, prescription_no: $('ctrlRx').value, doctor_name: $('ctrlDoctor').value };
          if (payload.controlled.patient_name.trim().length < 3 || !payload.controlled.national_id.trim() || !payload.controlled.prescription_no.trim()) {
            return fail('الصنف خاضع للرقابة: اكتب اسم المريض والرقم القومي ورقم الروشتة');
          }
        }
        payload.idempotency_key = 'pos-' + PAGE_KEY + '-' + hashStr(JSON.stringify(payload));
        const res = await fetch('/pos/checkout', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.ok) window.location.href = '/pos/receipt/' + data.invoiceId; else fail(data.error || 'حدث خطأ، يرجى المحاولة لاحقاً');
      } catch (e) { fail('حدث خطأ في الاتصال بالسيرفر'); }
    }
    $('checkoutBtn').addEventListener('click', doCheckout);

    // ---------- اختصارات الكيبورد (الأدمن بيحدد المفاتيح من الإعدادات) ----------
    // Ctrl+Enter ثابت لإتمام البيع، وباقي الاختصارات متحددة من /settings
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); doCheckout(); }
    });
    const focusEl = (id) => () => { const el = $(id); if (el) { el.focus(); if (el.select) el.select(); } };
    const payBtn = (v) => () => { const b = $('payTabs').querySelector('button[data-v="' + v + '"]'); if (b) b.click(); };
    Shortcuts.on('pos_checkout', () => { doCheckout(); });
    Shortcuts.on('pos_clear', () => { $('clearCartBtn').click(); });
    Shortcuts.on('pos_camera', () => { $('openCameraBtn').click(); });
    Shortcuts.on('pos_instock', () => { const c = $('instock'); c.checked = !c.checked; c.dispatchEvent(new Event('change', { bubbles: true })); });
    Shortcuts.on('pos_pay_cash', payBtn('cash'));
    Shortcuts.on('pos_pay_card', payBtn('card'));
    Shortcuts.on('pos_pay_other', payBtn('other'));
    Shortcuts.on('pos_discount', focusEl('discountValue'));
    Shortcuts.on('pos_coupon', focusEl('couponInput'));
    Shortcuts.on('pos_customer', focusEl('customerName'));
    Shortcuts.on('pos_notes', focusEl('notes'));
    // لو قايمة نتايج البحث ظاهرة والمؤشر في خانة البحث، الأسهم بتتنقل بين النتايج زي الأول (نسيب السهم لحاله)
    const cartKey = (fn) => (e) => {
      if (!cart.length) return false;
      if (e && e.target === $('q') && results.length) return false;
      return fn() === false ? false : undefined;
    };
    Shortcuts.on('pos_qty_up', cartKey(() => changeQty(1)));
    Shortcuts.on('pos_qty_down', cartKey(() => changeQty(-1)));
    Shortcuts.on('pos_item_prev', cartKey(() => moveActive(-1)));
    Shortcuts.on('pos_item_next', cartKey(() => moveActive(1)));
    Shortcuts.on('pos_item_del', cartKey(() => removeActive()));

    renderCart();
  </script>
</body>
</html>
