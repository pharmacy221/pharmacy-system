<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>الإعدادات - <%= shopName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <% var active = 'settings' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>الإعدادات</h1>
        <p>بيانات الصيدلية، كلمة المرور، وحسابات الموظفين</p>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="two-col">
      <div class="card">
        <h2>بيانات الصيدلية (تظهر في الفاتورة)</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-top:-8px; margin-bottom:16px;">
          اسم الصيدلية، رقم التليفون والعنوان هيتطبعوا تلقائياً على كل فاتورة بيع.
        </p>
        <form action="/settings/shop-info" method="POST">
          <div class="field">
            <label>اسم الصيدلية</label>
            <input type="text" name="name" value="<%= pharmacySettings.name || '' %>" placeholder="مثال: صيدلية النور">
          </div>
          <div class="field">
            <label>رقم تليفون الصيدلية</label>
            <input type="text" name="phone" value="<%= pharmacySettings.phone || '' %>" placeholder="مثال: 01012345678">
          </div>
          <div class="field">
            <label>عنوان الصيدلية</label>
            <input type="text" name="address" value="<%= pharmacySettings.address || '' %>" placeholder="مثال: شارع الجمهورية، المنصورة">
          </div>
          <button type="submit" class="btn">حفظ بيانات الصيدلية</button>
        </form>
      </div>

      <div class="card">
        <h2>طباعة الفاتورة</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-top:-8px; margin-bottom:16px;">
          اختار مقاس ورق الطابعة الحرارية. في الطباعة الحرارية خلّي إعدادات الطابعة: الهوامش «بدون»، والرؤوس والتذييلات مقفولة.
        </p>
        <form action="/settings/print" method="POST">
          <div class="field">
            <label>مقاس الورق</label>
            <select name="receipt_paper">
              <option value="80" <%= pharmacySettings.receipt_paper === '80' ? 'selected' : '' %>>حراري 80 مم</option>
              <option value="58" <%= pharmacySettings.receipt_paper === '58' ? 'selected' : '' %>>حراري 58 مم</option>
              <option value="a4" <%= pharmacySettings.receipt_paper === 'a4' ? 'selected' : '' %>>A4 (فاتورة كاملة)</option>
            </select>
          </div>
          <div class="field">
            <label style="display:flex; gap:8px; align-items:center; cursor:pointer;">
              <input type="checkbox" name="receipt_auto_print" <%= pharmacySettings.receipt_auto_print ? 'checked' : '' %> style="width:auto;"> طباعة تلقائية أول ما الفاتورة تتسجّل
            </label>
          </div>
          <div class="field">
            <label>سطر ختام الفاتورة</label>
            <input type="text" name="receipt_footer" maxlength="160" value="<%= pharmacySettings.receipt_footer || '' %>" placeholder="شكراً لتعاملكم معنا، نتمنى لكم الشفاء العاجل">
          </div>
          <button type="submit" class="btn">حفظ إعدادات الطباعة</button>
        </form>
      </div>

      <div class="card">
        <h2>تغيير كلمة المرور</h2>
        <form action="/settings/password" method="POST">
          <div class="field">
            <label>كلمة المرور الحالية</label>
            <input type="password" name="current_password" required>
          </div>
          <div class="field">
            <label>كلمة المرور الجديدة</label>
            <input type="password" name="new_password" required minlength="8">
          </div>
          <div class="field">
            <label>تأكيد كلمة المرور الجديدة</label>
            <input type="password" name="confirm_password" required minlength="8">
          </div>
          <button type="submit" class="btn">حفظ كلمة المرور</button>
        </form>
      </div>

      <div class="card">
        <h2>حسابات الموظفين</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-top:-8px; margin-bottom:16px;">
          ضيف حساب لكل صيدلي/كاشير بيشتغل في الصيدلية. الصيدلي والكاشير بيدخلوا بس على الكاشير والمبيعات والأصناف.
          لو ربطت الحساب بموظف من صفحة "الموظفين والرواتب"، هيتسجله حضور وانصراف تلقائي لما يفتح ويقفل الوردية.
        </p>

        <% if (employees.length === 0) { %>
          <div class="empty-state">مفيش موظفين مسجلين لسه</div>
        <% } else { %>
          <table>
            <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الدور</th><th>مرتبط بموظف رواتب</th><th></th></tr></thead>
            <tbody>
              <% employees.forEach(emp => { %>
                <tr>
                  <td data-label="الاسم"><%= emp.full_name || '-' %></td>
                  <td class="mono" data-label="اسم المستخدم"><%= emp.username %></td>
                  <td data-label="الدور"><%= emp.role === 'pharmacist' ? 'صيدلي' : 'كاشير' %></td>
                  <td data-label="مرتبط بموظف رواتب">
                    <form action="/settings/employees/<%= emp.id %>/link" method="POST" style="display:flex; gap:6px;">
                      <select name="employee_id" style="min-width:130px;">
                        <option value="">بدون ربط</option>
                        <% payrollEmployees.forEach(pe => { %>
                          <option value="<%= pe.id %>" <%= emp.employee_id === pe.id ? 'selected' : '' %>><%= pe.name %></option>
                        <% }) %>
                      </select>
                      <button class="btn-ghost-sm" type="submit">حفظ</button>
                    </form>
                  </td>
                  <td style="display:flex; gap:6px; flex-wrap:wrap;" data-label="إجراءات">
                    <form action="/settings/employees/<%= emp.id %>/reset-password" method="POST" style="display:flex; gap:6px;" onsubmit="return confirm('تأكيد تغيير الباسورد؟')">
                      <input type="password" name="new_password" placeholder="باسورد جديد" required minlength="6" style="width:130px;">
                      <button class="btn-ghost-sm" type="submit">تغيير الباسورد</button>
                    </form>
                    <form action="/settings/employees/<%= emp.id %>/delete" method="POST" onsubmit="return confirm('تأكيد حذف حساب الموظف ده؟')">
                      <button class="btn-ghost-sm" type="submit">حذف الحساب</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>

        <form action="/settings/employees/add" method="POST" style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap;">
          <input type="text" name="full_name" placeholder="اسم الموظف" style="flex:1; min-width:140px;">
          <input type="text" name="username" placeholder="اسم مستخدم" required style="flex:1; min-width:140px;">
          <input type="password" name="password" placeholder="كلمة المرور" required minlength="6" style="flex:1; min-width:140px;">
          <select name="role" style="flex:1; min-width:120px;">
            <option value="cashier">كاشير</option>
            <option value="pharmacist">صيدلي</option>
          </select>
          <select name="employee_id" style="flex:1; min-width:160px;">
            <option value="">ربط بموظف رواتب (اختياري)</option>
            <% payrollEmployees.forEach(pe => { %>
              <option value="<%= pe.id %>"><%= pe.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn" style="white-space:nowrap;">إضافة موظف</button>
        </form>
      </div>

      <div class="card" id="shortcuts" style="grid-column: 1 / -1;">
        <h2>اختصارات الكيبورد</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-top:-8px; margin-bottom:16px;">
          اضغط على الخانة وبعدين اضغط المفاتيح اللي عاوزها (مثلًا <kbd>F9</kbd> أو <kbd>Ctrl</kbd>+<kbd>K</kbd>). الاختصار بيشتغل مع كل الموظفين.
          <b>Backspace</b> يمسح الاختصار. الأسهم (↑ ↓ ← →) و Home/End/PageUp/PageDown تنفع لوحدها من غير Ctrl. الحروف والأرقام لازم معاها Ctrl أو Alt، وبتشتغل حتى لو الكيبورد عربي.
        </p>
        <form action="/settings/shortcuts" method="POST" id="scForm">
          <% const groupsSeen = []; shortcutActions.forEach(a => { if (!groupsSeen.includes(a.group)) groupsSeen.push(a.group); }); %>
          <% groupsSeen.forEach(g => { %>
            <h3 style="margin:18px 0 8px; font-size:14px; color:var(--accent);"><%= g %></h3>
            <table>
              <tbody>
                <% shortcutActions.filter(a => a.group === g).forEach(a => { %>
                  <tr>
                    <td data-label="الإجراء" style="width:45%;"><%= a.label %></td>
                    <td data-label="الاختصار">
                      <div style="display:flex; gap:6px; align-items:center;">
                        <input type="text" readonly class="sc-input mono" name="sc_<%= a.id %>" data-id="<%= a.id %>"
                          data-default="<%= shortcutDefaults[a.id] %>" value="<%= shortcutKeys[a.id] || '' %>"
                          placeholder="اضغط هنا ثم المفاتيح" style="max-width:200px; text-align:center; cursor:pointer;" dir="ltr">
                        <button type="button" class="btn-ghost-sm sc-clear" title="مسح الاختصار">مسح</button>
                        <button type="button" class="btn-ghost-sm sc-default" title="الرجوع للافتراضي">افتراضي<%= shortcutDefaults[a.id] ? ' (' + shortcutDefaults[a.id] + ')' : ' (بدون)' %></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% }) %>
          <div id="scWarn" class="alert alert-error" style="display:none; margin-top:12px;"></div>
          <div style="display:flex; gap:8px; margin-top:16px; flex-wrap:wrap;">
            <button type="submit" class="btn" id="scSave">حفظ الاختصارات</button>
            <button type="submit" class="btn-outline btn-sm" name="reset" value="1" onclick="return confirm('الرجوع لكل الاختصارات الافتراضية؟')" formnovalidate>رجوع للافتراضي</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var inputs = Array.prototype.slice.call(document.querySelectorAll('.sc-input'));
      var warn = document.getElementById('scWarn');
      var save = document.getElementById('scSave');

      function validate() {
        var seen = {}, dup = null;
        inputs.forEach(function (i) {
          i.style.borderColor = '';
          if (!i.value) return;
          if (seen[i.value]) { dup = i.value; seen[i.value].style.borderColor = 'var(--red, #e55)'; i.style.borderColor = 'var(--red, #e55)'; }
          else seen[i.value] = i;
        });
        warn.style.display = dup ? '' : 'none';
        warn.textContent = dup ? 'الاختصار ' + dup + ' متكرر في أكتر من إجراء — غيّر واحد منهم قبل الحفظ' : '';
        save.disabled = !!dup;
      }

      inputs.forEach(function (inp) {
        inp.addEventListener('focus', function () { Shortcuts.paused = true; inp.select(); });
        inp.addEventListener('blur', function () { Shortcuts.paused = false; });
        inp.addEventListener('keydown', function (e) {
          if (e.key === 'Tab') return;
          e.preventDefault(); e.stopPropagation();
          if (e.key === 'Backspace' || e.key === 'Delete') { inp.value = ''; validate(); return; }
          if (e.key === 'Escape') { inp.blur(); return; }
          var combo = Shortcuts.comboOf(e);
          if (!combo) return; // مفتاح تعديل لوحده (Ctrl/Alt/Shift)
          var isF = /(?:^|\+)F\d+$/.test(combo);
          var hasMod = /(?:^|\+)(?:Ctrl|Alt|Meta)\+/.test(combo);
          var named = /(?:^|\+)(?:Insert|Delete|Home|End|PageUp|PageDown|ArrowUp|ArrowDown|ArrowLeft|ArrowRight)$/.test(combo);
          if (!isF && !named && !hasMod) {
            warn.style.display = ''; warn.textContent = 'الحروف والأرقام لازم معاها Ctrl أو Alt';
            return;
          }
          inp.value = combo; validate();
        });
      });
      document.querySelectorAll('.sc-clear').forEach(function (b) {
        b.addEventListener('click', function () { var i = b.closest('td').querySelector('.sc-input'); i.value = ''; validate(); });
      });
      document.querySelectorAll('.sc-default').forEach(function (b) {
        b.addEventListener('click', function () { var i = b.closest('td').querySelector('.sc-input'); i.value = i.getAttribute('data-default') || ''; validate(); });
      });
      validate();
    })();
  </script>
</body>
</html>
