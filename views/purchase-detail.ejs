<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>فاتورة شراء #<%= invoice.id %> - <%= shopName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <% var active = 'purchases' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>فاتورة شراء #<%= invoice.id %> <% if (invoice.status === 'cancelled') { %><span class="badge badge-ignored">ملغاة</span><% } %></h1>
        <p><%= invoice.supplier_name %> — رقم فاتورة المورد: <%= invoice.invoice_number || '—' %></p>
      </div>
      <a href="/purchases" class="btn-ghost-sm">← رجوع للفواتير</a>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (ok) { %><div class="alert alert-success"><%= ok %></div><% } %>

    <div class="stat-grid">
      <div class="stat-card"><div class="label">الإجمالي</div><div class="value mono"><%= Number(invoice.total_amount).toFixed(2) %> ج.م</div></div>
      <div class="stat-card"><div class="label">المدفوع</div><div class="value mono"><%= Number(invoice.paid_amount).toFixed(2) %> ج.م</div></div>
      <div class="stat-card"><div class="label">المتبقي</div><div class="value err mono"><%= invoice.status === 'cancelled' ? '—' : Number(invoice.remaining).toFixed(2) + ' ج.م' %></div></div>
    </div>

    <div class="card">
      <h2>البنود</h2>
      <table>
        <thead><tr><th>الصنف</th><th>التشغيلة</th><th>الصلاحية</th><th>الكمية المُدخلة</th><th>سعر الوحدة</th><th>بالحبة</th><th>تكلفة الحبة</th><th>الإجمالي</th><th>المتبقي في المخزن</th></tr></thead>
        <tbody>
          <% const U = { unit: 'حبة', strip: 'شريط', box: 'علبة' }; %>
          <% items.forEach(i => { %>
            <tr>
              <td data-label="الصنف"><%= i.medicine_name %></td>
              <td class="mono" data-label="التشغيلة"><%= i.batch_number || '—' %></td>
              <td class="mono" data-label="الصلاحية"><%= new Date(i.expiry_date).toLocaleDateString('ar-EG') %></td>
              <td class="mono" data-label="الكمية المُدخلة"><%= i.entry_quantity %> <%= U[i.entry_unit] %></td>
              <td class="mono" data-label="سعر الوحدة"><%= Number(i.entry_cost).toFixed(2) %></td>
              <td class="mono" data-label="بالحبة"><%= i.quantity_units %></td>
              <td class="mono" data-label="تكلفة الحبة"><%= Number(i.cost_price_unit).toFixed(4) %></td>
              <td class="mono" data-label="الإجمالي"><%= Number(i.line_total).toFixed(2) %></td>
              <td class="mono" data-label="المتبقي في المخزن"><%= i.batch_remaining === null ? '—' : i.batch_remaining %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p style="color:var(--text-muted); font-size:13px;">
        التاريخ: <%= new Date(invoice.invoice_date).toLocaleDateString('ar-EG') %>
        <% if (invoice.due_date) { %> — الاستحقاق: <%= new Date(invoice.due_date).toLocaleDateString('ar-EG') %><% } %>
        — سجّلها: <%= invoice.created_by_name || '—' %>
        <% if (invoice.notes) { %><br>ملاحظات: <%= invoice.notes %><% } %>
        <% if (invoice.status === 'cancelled') { %><br>سبب الإلغاء: <%= invoice.cancel_reason %><% } %>
      </p>
    </div>

    <div class="two-col">
      <div class="card">
        <h2>الدفعات</h2>
        <% if (payments.length === 0) { %>
          <div class="empty-state">مفيش دفعات على الفاتورة دي</div>
        <% } else { %>
          <table>
            <thead><tr><th>التاريخ</th><th>المبلغ</th><th>الطريقة</th><th>بواسطة</th><th>ملاحظة</th></tr></thead>
            <tbody>
              <% payments.forEach(p => { %>
                <tr>
                  <td class="mono" data-label="التاريخ"><%= new Date(p.created_at).toLocaleString('ar-EG') %></td>
                  <td class="mono" data-label="المبلغ"><%= Number(p.amount).toFixed(2) %></td>
                  <td data-label="الطريقة"><%= {cash:'نقدي', bank:'بنكي', other:'أخرى'}[p.method] %></td>
                  <td data-label="بواسطة"><%= p.user_name || '—' %></td>
                  <td data-label="ملاحظة"><%= p.note || '' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <% if (isAdmin && invoice.status === 'received') { %>
      <div class="card">
        <% if (Number(invoice.remaining) > 0) { %>
          <h2>تسجيل دفعة</h2>
          <form action="/purchases/<%= invoice.id %>/pay" method="POST">
            <div class="form-grid">
              <div class="field"><label>المبلغ (المتبقي <%= Number(invoice.remaining).toFixed(2) %>)</label>
                <input type="number" step="0.01" min="0.01" max="<%= Number(invoice.remaining).toFixed(2) %>" name="amount" required></div>
              <div class="field"><label>الطريقة</label>
                <select name="method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option><option value="other">أخرى</option></select></div>
            </div>
            <div class="field"><label>ملاحظة</label><input type="text" name="note" maxlength="300"></div>
            <button type="submit" class="btn">تسجيل الدفعة</button>
          </form>
        <% } %>
        <% if (Number(invoice.paid_amount) === 0) { %>
          <h3 class="section-title" style="margin-top:20px;">إلغاء الفاتورة</h3>
          <p style="color:var(--text-muted); font-size:13px;">بيرجّع المخزون. مسموح بس لو مفيش دفعات ولسه مفيش حاجة اتباعت من تشغيلاتها.</p>
          <form action="/purchases/<%= invoice.id %>/cancel" method="POST" onsubmit="return confirm('تأكيد إلغاء الفاتورة وعكس المخزون؟')">
            <div class="field"><label>سبب الإلغاء *</label><input type="text" name="reason" required maxlength="300"></div>
            <button type="submit" class="btn btn-danger">إلغاء الفاتورة</button>
          </form>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</body>
</html>
