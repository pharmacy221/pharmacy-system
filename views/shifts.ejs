<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>الوردية - <%= shopName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <% var active = 'shifts' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>إدارة الوردية</h1>
        <p>فتح وقفل درج الكاش وتتبع مبيعات الوردية</p>
      </div>
    </div>

    <% if (!activeShift) { %>
      <div class="card">
        <h2>فتح وردية جديدة</h2>
        <form action="/shifts/start" method="POST">
          <div class="field">
            <label>المبلغ الافتتاحي في الخزينة (النقدية الأولية)</label>
            <input type="number" step="0.01" name="opening_balance" value="0" required>
          </div>
          <button type="submit" class="btn">بدء الوردية</button>
        </form>
      </div>
    <% } else { %>
      <div class="card">
        <h2>الوردية الحالية مفتوحة</h2>
        <div class="field"><label>تاريخ البداية</label><div class="mono"><%= new Date(activeShift.opened_at).toLocaleString('ar-EG') %></div></div>
        <div class="field"><label>النقدية الافتتاحية</label><div class="mono"><%= Number(activeShift.opening_balance).toFixed(2) %> ج.م</div></div>
        <div class="field"><label>مبيعات الوردية حتى الآن</label><div class="mono accent"><%= Number(liveSalesTotal).toFixed(2) %> ج.م</div></div>

        <hr style="border-color: var(--border-color, #2a2f3a); margin: 16px 0;">

        <form action="/shifts/close" method="POST">
          <div class="field">
            <label>المبلغ الفعلي الموجود بالدرج حالياً (بعد العد)</label>
            <input type="number" step="0.01" name="closing_balance" required placeholder="أدخل المبلغ الموجود في الدرج الآن">
          </div>
          <button type="submit" class="btn btn-danger">إنهاء وإغلاق الوردية</button>
        </form>
      </div>
    <% } %>

    <div class="card">
      <h2>سجل الورديات السابقة</h2>
      <% if (!pastShifts || pastShifts.length === 0) { %>
        <div class="empty-state">لسه مفيش ورديات مغلقة</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>الكاشير</th><th>تاريخ البداية</th><th>تاريخ الإغلاق</th><th>الافتتاحي</th><th>الختامي</th></tr>
          </thead>
          <tbody>
            <% pastShifts.forEach(s => { %>
              <tr>
                <td data-label="الكاشير"><%= s.user_full_name || s.user_username %></td>
                <td class="mono" style="color:var(--text-muted)" data-label="تاريخ البداية"><%= new Date(s.opened_at).toLocaleString('ar-EG') %></td>
                <td class="mono" style="color:var(--text-muted)" data-label="تاريخ الإغلاق"><%= s.closed_at ? new Date(s.closed_at).toLocaleString('ar-EG') : '-' %></td>
                <td class="mono" data-label="الافتتاحي"><%= Number(s.opening_balance).toFixed(2) %></td>
                <td class="mono" data-label="الختامي"><%= s.closing_balance !== null ? Number(s.closing_balance).toFixed(2) : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
