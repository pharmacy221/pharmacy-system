<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>التشغيلات والطلبيات - <%= shopName %></title>
  <%- include('partials/head') %>
  <style>
    .pi-lines td { padding: 6px 4px; vertical-align: top; }
    .pi-lines input, .pi-lines select { min-width: 0; width: 100%; }
    .pi-total { font-size: 20px; font-weight: 700; }
    .dd-wrap { position: relative; }
    .dd { position: absolute; inset-inline: 0; top: 100%; z-index: 30; background: var(--surface); color: var(--text); border: 1px solid var(--border);
          border-radius: 8px; max-height: 320px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,.35); display: none; }
    .dd button { display: block; width: 100%; text-align: right; padding: 8px 12px; background: transparent; border: 0; border-bottom: 1px solid var(--border); cursor: pointer; font: inherit; color: var(--text); }
    .dd button:hover, .dd button.on { background: var(--accent-soft); }
    .dd small { display: block; color: var(--text-muted); font-size: 12px; }
    .chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--text); font-weight: 600; }
    .chip a { color: var(--accent); }
    .scan-msg { font-size: 13px; margin: 6px 0; min-height: 18px; }
    .scan-msg.err { color: var(--danger); } .scan-msg.ok { color: var(--accent); }
    .modal-bg { position: fixed; inset: 0; background: var(--overlay); display: none; align-items: center; justify-content: center; z-index: 100; padding: 12px; }
    .modal { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 12px; padding: 20px; width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto; }
    .modal h3 { margin: 0 0 12px; }
    .modal .actions { display: flex; gap: 8px; margin-top: 14px; }
    .modal .err { color: var(--danger); font-size: 13px; min-height: 18px; margin-top: 8px; }
    .inline-row { display: flex; gap: 8px; align-items: stretch; }
    .inline-row input { flex: 1; }
    .cost-hint { font-size: 11px; color: var(--text-muted); margin-top: 3px; line-height: 1.4; }
    .cost-hint.warn { color: var(--amber); font-weight: 700; }
    .pi-lines input.low { border-color: var(--amber); box-shadow: 0 0 0 2px rgba(245, 158, 11, .25); }
    #camReader { width: 100%; min-height: 220px; }
    details.card > summary { cursor: pointer; font-size: 18px; font-weight: 700; }
  </style>
</head>
<body>
  <% var active = 'batches' %>
  <%- include('partials/nav') %>
  <%
    function bigQty(b) {
      var f = (parseInt(b.units_per_strip) || 1) * (parseInt(b.strips_per_box) || 1);
      if (f > 1) {
        var boxes = Math.floor(b.quantity_units / f), rest = b.quantity_units % f;
        return boxes + ' علبة' + (rest ? ' + ' + rest + ' حبة' : '');
      }
      return b.quantity_units + ' ' + (b.form_kind ? singleLabel(b.form_kind) : 'حبة');
    }
  %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>التشغيلات والطلبيات</h1>
        <p>استلام الطلبيات من الموردين (بالعلبة وبنسبة الخصم) وتتبّع الصلاحية لكل تشغيلة</p>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (canReceive) { %>
    <form action="/purchases/create" method="POST" id="piForm" autocomplete="off">
      <input type="hidden" name="idempotency_key" value="<%= idempotencyKey %>">
      <input type="hidden" name="items_json" id="itemsJson">
      <input type="hidden" name="supplier_id" id="supplierId">

      <div class="card">
        <h2>استلام طلبية جديدة</h2>
        <div class="form-grid">
          <div class="field dd-wrap">
            <label style="display:flex; justify-content:space-between; align-items:center; gap:8px;"><span>المورد * (بالاسم أو الشركة أو المندوب)</span>
              <button type="button" class="btn-ghost-sm" id="newSupBtn" style="white-space:nowrap;">➕ مورد جديد</button></label>
            <input type="text" id="supSearch" placeholder="اكتب اسم المورد أو الشركة...">
            <div class="dd" id="supList"></div>
            <div id="supChip" style="display:none; margin-top:6px;"></div>
          </div>
          <div class="field"><label>رقم فاتورة المورد</label><input type="text" name="invoice_number" maxlength="80"></div>
          <div class="field"><label>تاريخ الطلبية</label><input type="date" name="invoice_date" value="<%= today %>"></div>
          <div class="field"><label>ميعاد الاستحقاق (للآجل)</label><input type="date" name="due_date"></div>
          <div class="field"><label>خصم إضافي على الطلبية كلها %</label><input type="number" name="discount_percent" id="disc" min="0" max="100" step="0.01" value="0"></div>
        </div>
      </div>

      <div class="card">
        <h2>أصناف الطلبية</h2>
        <div class="field dd-wrap">
          <label style="display:flex; justify-content:space-between; align-items:center; gap:8px;"><span>ابحث عن صنف (اسم / شركة / سيريال / باركود) أو اسكن الباركود مباشرة</span>
            <button type="button" class="btn-ghost-sm" id="newItemBtn" style="white-space:nowrap;">➕ صنف جديد</button></label>
          <input type="text" id="itemSearch" data-scan-target data-scan-submit="no" placeholder="اكتب أو اسكن الباركود...">
          <div class="dd" id="itemList"></div>
        </div>
        <div class="scan-msg" id="scanMsg"></div>
        <table class="pi-lines">
          <thead><tr><th style="width:24%">الصنف</th><th>الوحدة</th><th>الكمية</th><th>سعر الوحدة</th><th>خصم الصنف %</th><th>الصلاحية</th><th>رقم التشغيلة</th><th>الإجمالي بعد الخصم</th><th></th></tr></thead>
          <tbody id="lines"></tbody>
        </table>
        <div id="emptyLines" class="empty-state">لسه ما اتضافش أي صنف — ابحث أو اسكن الباركود</div>
        <p style="color:var(--text-muted); font-size:13px;">الكمية بتتسجل بالوحدة الكبيرة حسب نوع الصنف (علبة للحبوب والفوار، وحدة الصنف للحقن والشراب...) — والنظام بيحوّلها للحبة تلقائيًا ويطبّق الخصم على تكلفة كل صنف.</p>
      </div>

      <div class="card">
        <div class="form-grid">
          <div class="field"><label>الإجمالي قبل الخصم</label><div class="pi-total mono"><span id="subtotal">0.00</span> ج.م</div></div>
          <div class="field"><label>إجمالي الخصم (الأصناف + الطلبية)</label><div class="pi-total mono">− <span id="discAmt">0.00</span> ج.م</div></div>
          <div class="field"><label>الصافي</label><div class="pi-total mono"><span id="grand">0.00</span> ج.م</div></div>
          <div class="field"><label>المدفوع الآن (0 = آجل)</label><input type="number" step="0.01" min="0" name="paid_amount" id="paid" value="0"></div>
          <div class="field"><label>طريقة الدفع</label>
            <select name="method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option><option value="other">أخرى</option></select></div>
          <div class="field"><label>المتبقي على المورد</label><div class="pi-total mono"><span id="remain">0.00</span> ج.م</div></div>
        </div>
        <div class="field"><label>ملاحظات</label><input type="text" name="notes" maxlength="500"></div>
        <button type="submit" class="btn" id="submitBtn">تسجيل الطلبية واستلام البضاعة</button>
        <span style="color:var(--text-muted); font-size:13px; margin-inline-start:8px;">بعد التسجيل تقدر تطبع الفاتورة من صفحة الطلبية.</span>
      </div>
    </form>

    <div class="modal-bg" id="supModal"><div class="modal">
      <h3>➕ إضافة مورد جديد</h3>
      <div class="field"><label>اسم المورد *</label><input type="text" id="sm_name" maxlength="150"></div>
      <div class="field"><label>الشركة اللي المندوب بيمثّلها</label><input type="text" id="sm_company" maxlength="150"></div>
      <div class="form-grid">
        <div class="field"><label>اسم المندوب</label><input type="text" id="sm_rep" maxlength="150"></div>
        <div class="field"><label>التليفون</label><input type="text" id="sm_phone" maxlength="40"></div>
      </div>
      <div class="err" id="sm_err"></div>
      <div class="actions"><button type="button" class="btn" id="sm_save">حفظ واختيار المورد</button><button type="button" class="btn-outline btn-sm" data-close="supModal">إلغاء</button></div>
    </div></div>

    <div class="modal-bg" id="itemModal"><div class="modal">
      <h3>➕ إضافة صنف جديد</h3>
      <div class="field"><label>اسم الصنف *</label><input type="text" id="im_name" maxlength="200"></div>
      <div class="field"><label>الباركود (اسكنه دلوقتي أو ولّد واحد عشوائي)</label>
        <div class="inline-row"><input type="text" id="im_barcode" dir="ltr" maxlength="64" placeholder="اسكن الباركود هنا..."><button type="button" class="btn-outline btn-sm" id="im_cam" title="مسح بالكاميرا">📷</button><button type="button" class="btn-outline btn-sm" id="im_gen">🎲 توليد عشوائي</button></div>
        <div class="scan-msg" id="im_scan"></div></div>
      <div class="form-grid">
        <div class="field"><label>النوع</label><select id="im_form"></select></div>
        <div class="field"><label>سعر بيع العلبة (اختياري)</label><input type="number" id="im_price" min="0" step="0.01" placeholder="0.00"></div>
        <div class="field" id="im_upsBox"><label>عدد الحبات في الشريط/العلبة</label><input type="number" id="im_ups" min="1" step="1" value="1"></div>
        <div class="field" id="im_spbBox"><label>عدد الشرايط في العلبة</label><input type="number" id="im_spb" min="1" step="1" value="1"></div>
        <div class="field"><label>الشركة المصنّعة</label><input type="text" id="im_mfr" maxlength="150"></div>
        <div class="field"><label>السيريال (اختياري)</label><input type="text" id="im_serial" dir="ltr" maxlength="64"></div>
        <div class="field"><label>كلمة اختصار للكاشير (اختياري)</label><input type="text" id="im_shortcut" maxlength="40" placeholder="كلمة واحدة، مثال: بنا"></div>
      </div>
      <p style="color:var(--text-muted); font-size:12px; margin:0 0 6px;">كلمة الاختصار: تكتبها في خانة البحث في الكاشير وتدوس Enter فالصنف يتضاف للفاتورة علطول.</p>
      <p style="color:var(--text-muted); font-size:12px; margin:0;">سعر الشريط والحبة بيتحسبوا تلقائيًا من سعر العلبة، وتقدر تعدّلهم بعدين من صفحة الأصناف.</p>
      <div class="err" id="im_err"></div>
      <div class="actions"><button type="button" class="btn" id="im_save">حفظ وإضافة للطلبية</button><button type="button" class="btn-outline btn-sm" data-close="itemModal">إلغاء</button></div>
    </div></div>

    <div class="modal-bg" id="camModal"><div class="modal">
      <h3>📷 وجّه الكاميرا على الباركود</h3>
      <div id="camReader"></div>
      <div class="actions"><button type="button" class="btn-outline btn-sm" data-close="camModal">إغلاق</button></div>
    </div></div>
    <% } %>

    <form method="GET" action="/products/batches" class="card" style="display:flex; gap:8px; align-items:center;">
      <input type="text" name="q" value="<%= q %>" placeholder="ابحث في الطلبيات والتشغيلات: اسم صنف / سيريال / باركود / مورد / شركة / رقم تشغيلة"
             style="flex:1" <%- canReceive ? '' : 'data-scan-target' %>>
      <button class="btn" type="submit">بحث</button>
      <% if (q) { %><a class="btn-ghost-sm" href="/products/batches">مسح</a><% } %>
    </form>

    <div class="card">
      <h2>الطلبيات (آخر <%= orders.length %>)</h2>
      <% if (orders.length === 0) { %>
        <div class="empty-state">مفيش طلبيات<%= q ? ' مطابقة للبحث' : ' مسجلة لسه' %></div>
      <% } else { %>
        <table>
          <thead><tr><th>#</th><th>التاريخ</th><th>المورد</th><th>رقم فاتورة المورد</th><th>الأصناف</th><th>الخصم</th><th>الصافي</th><th>المتبقي</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td class="mono" data-label="#"><a href="/purchases/<%= o.id %>"><%= o.id %></a></td>
                <td class="mono" data-label="التاريخ"><%= new Date(o.invoice_date).toLocaleDateString('ar-EG') %></td>
                <td data-label="المورد"><%= o.supplier_name %><% if (o.supplier_company) { %><br><span style="color:var(--text-muted); font-size:12px;"><%= o.supplier_company %></span><% } %></td>
                <td class="mono" data-label="رقم فاتورة المورد"><%= o.invoice_number || '—' %></td>
                <td class="mono" data-label="الأصناف"><%= o.items_count %></td>
                <td class="mono" data-label="الخصم"><%= Number(o.discount_percent) > 0 ? Number(o.discount_percent) + '%' : '—' %></td>
                <td class="mono" data-label="الصافي"><%= Number(o.total_amount).toFixed(2) %></td>
                <td class="mono" data-label="المتبقي"><% if (o.status === 'cancelled') { %><span class="badge badge-ignored">ملغاة</span><% } else { %><%= (Number(o.total_amount) - Number(o.paid_amount)).toFixed(2) %><% } %></td>
                <td data-label=""><a class="btn-ghost-sm" href="/purchases/<%= o.id %>/print" target="_blank">🖨️ طباعة</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h2>التشغيلات الحالية (<%= batches.length %>)</h2>
      <% if (batches.length === 0) { %>
        <div class="empty-state">مفيش تشغيلات<%= q ? ' مطابقة للبحث' : ' مسجلة لسه' %></div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>الصنف</th><th>رقم التشغيلة</th><th>المورد</th><th>الصلاحية</th><th>المتبقي</th><th>الطلبية</th></tr>
          </thead>
          <tbody>
            <% batches.forEach(b => { %>
              <tr>
                <td data-label="الصنف"><%= b.medicine_name %><% if (b.serial_number || b.barcode) { %><br><span class="mono" style="color:var(--text-muted); font-size:11px;"><%= b.serial_number ? 'سيريال: ' + b.serial_number : '' %><%= (b.serial_number && b.barcode) ? ' — ' : '' %><%= b.barcode ? 'باركود: ' + b.barcode : '' %></span><% } %></td>
                <td class="mono" style="color:var(--text-muted); font-size:12px;" data-label="رقم التشغيلة"><%= b.batch_number || '—' %></td>
                <td style="color:var(--text-muted)" data-label="المورد"><%= b.supplier_name || '—' %><% if (b.supplier_company) { %><br><span style="font-size:12px;"><%= b.supplier_company %></span><% } %></td>
                <td class="mono" data-label="الصلاحية"
                    style="<%= b.days_left < 0 ? 'color:var(--danger)' : (b.days_left <= 90 ? 'color:var(--amber)' : '') %>">
                  <%= new Date(b.expiry_date).toLocaleDateString('ar-EG') %>
                  <% if (b.days_left < 0) { %><br><span class="badge badge-ignored">منتهية</span>
                  <% } else if (b.days_left <= 90) { %><br><span class="badge badge-pending">باقي <%= b.days_left %> يوم</span><% } %>
                </td>
                <td class="mono" data-label="المتبقي"><%= bigQty(b) %></td>
                <td class="mono" data-label="الطلبية"><% if (b.purchase_invoice_id) { %><a href="/purchases/<%= b.purchase_invoice_id %>">#<%= b.purchase_invoice_id %></a><% } else { %>—<% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

<% if (canReceive) { %>
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var tbody = $('lines'), itemSearch = $('itemSearch'), itemList = $('itemList'), supSearch = $('supSearch'), supList = $('supList');
  var MEDS = {};
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function debounce(fn, ms) { var t; return function () { var a = arguments, c = this; clearTimeout(t); t = setTimeout(function () { fn.apply(c, a); }, ms); }; }
  function msg(text, type) { var m = $('scanMsg'); m.textContent = text || ''; m.className = 'scan-msg ' + (type || ''); }
  function getJson(url) { return fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }); }

  // ---------- قائمة منسدلة عامة (مع الأسهم و Enter) ----------
  function Dropdown(input, list, fetcher, render, onPick) {
    var items = [], idx = -1;
    function draw() {
      if (!items.length) { list.style.display = 'none'; return; }
      list.innerHTML = items.map(function (it, i) { return '<button type="button" data-i="' + i + '" class="' + (i === idx ? 'on' : '') + '">' + render(it) + '</button>'; }).join('');
      list.style.display = 'block';
    }
    var run = debounce(function () {
      var q = input.value.trim();
      fetcher(q).then(function (r) { items = r; idx = items.length ? 0 : -1; draw(); });
    }, 200);
    input.addEventListener('input', run);
    input.addEventListener('focus', function () { if (input.value.trim() || input.getAttribute('data-open-empty')) run(); });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); if (items.length) { idx = Math.min(idx + 1, items.length - 1); draw(); } }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (items.length) { idx = Math.max(idx - 1, 0); draw(); } }
      else if (e.key === 'Escape') { list.style.display = 'none'; }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (items.length && idx >= 0 && list.style.display === 'block') { pick(items[idx]); }
        else if (input.value.trim()) { fetcher(input.value.trim()).then(function (r) { items = r; idx = 0; if (r.length === 1) pick(r[0]); else draw(); }); }
      }
    });
    list.addEventListener('mousedown', function (e) { var b = e.target.closest('button'); if (b) { e.preventDefault(); pick(items[+b.getAttribute('data-i')]); } });
    document.addEventListener('click', function (e) { if (!e.target.closest('.dd-wrap')) list.style.display = 'none'; });
    function pick(it) { list.style.display = 'none'; items = []; onPick(it); }
  }

  // ---------- المورد ----------
  function selectSupplier(s) {
    $('supplierId').value = s.id; supSearch.value = ''; supSearch.style.display = 'none';
    var chip = $('supChip'); chip.style.display = 'block';
    chip.innerHTML = '<span class="chip">' + esc(s.name) + (s.company ? ' — ' + esc(s.company) : '') + ' <a href="#" id="supChange" style="font-size:12px">تغيير</a></span>';
    $('supChange').addEventListener('click', function (e) { e.preventDefault(); $('supplierId').value = ''; chip.style.display = 'none'; supSearch.style.display = ''; supSearch.focus(); });
    itemSearch.focus();
  }
  Dropdown(supSearch, supList,
    function (q) { return getJson('/purchases/api/suppliers?q=' + encodeURIComponent(q)).then(function (d) { return d.results.length || !q ? d.results : [{ __new: true, q: q }]; }); },
    function (s) { if (s.__new) return '➕ إضافة مورد جديد «' + esc(s.q) + '»'; return esc(s.name) + '<small>' + esc([s.company, s.rep_name ? 'مندوب: ' + s.rep_name : '', s.phone].filter(Boolean).join(' — ')) + '</small>'; },
    function (s) { if (s.__new) openSupModal(s.q); else selectSupplier(s); });
  supSearch.setAttribute('data-open-empty', '1');

  // ---------- الأصناف ----------
  Dropdown(itemSearch, itemList,
    function (q) { return getJson('/purchases/api/medicines?q=' + encodeURIComponent(q)).then(function (d) { return d.results.length ? d.results : [{ __new: true, q: q }]; }); },
    function (m) {
      if (m.__new) return '➕ الصنف مش موجود — إضافة صنف جديد «' + esc(m.q) + '»';
      return esc(m.name) + '<small>' + esc([m.form, m.manufacturer, m.serial_number ? 'سيريال: ' + m.serial_number : '', m.barcode ? 'باركود: ' + m.barcode : '', 'المخزون: ' + m.stock_units].filter(Boolean).join(' — ')) + '</small>';
    },
    function (m) { if (m.__new) { openItemModal(m.q); return; } addLine(m); itemSearch.value = ''; msg(''); });

  function addLine(med) {
    MEDS[med.id] = med;
    var tr = document.createElement('tr');
    tr.setAttribute('data-med', med.id);
    var levels = med.levels.slice().reverse();      // الأكبر أولًا
    tr.innerHTML =
      '<td data-label="الصنف">' + esc(med.name) + '<div style="color:var(--text-muted);font-size:11px">' + esc(med.form || '') + '</div></td>' +
      '<td data-label="الوحدة"><select class="f-unit">' + levels.map(function (l) { return '<option value="' + l.key + '">' + esc(l.label) + '</option>'; }).join('') + '</select></td>' +
      '<td data-label="الكمية"><input type="number" min="1" step="1" class="f-qty" value="1"></td>' +
      '<td data-label="سعر الوحدة"><input type="number" min="0" step="0.01" class="f-cost" placeholder="0.00"><div class="cost-hint"></div></td>' +
      '<td data-label="خصم الصنف %"><input type="number" min="0" max="100" step="0.01" class="f-disc" value="0"></td>' +
      '<td data-label="الصلاحية"><input type="date" class="f-exp"></td>' +
      '<td data-label="رقم التشغيلة"><input type="text" class="f-batch" maxlength="80"></td>' +
      '<td class="mono f-line" data-label="الإجمالي">0.00</td>' +
      '<td><button type="button" class="btn-ghost-sm f-del" title="حذف">✕</button></td>';
    tr.querySelector('.f-unit').value = med.default_unit;
    tbody.appendChild(tr);
    prefillCost(tr);
    refresh();
    var c = tr.querySelector('.f-cost'); c.focus(); if (c.select) c.select();
    return tr;
  }

  // ---------- آخر سعر شراء متسجّل للصنف: بنعبّيه تلقائيًا وبنحذّر لو السعر الجديد أقل ----------
  function fmt(n) { return (Math.round(n * 100) / 100).toFixed(2); }
  function lastCostFor(med, unitKey) {
    var lc = med && med.last_cost; if (!lc) return null;
    var lv = med.levels.filter(function (l) { return l.key === unitKey; })[0];
    return lv ? Math.round(lc.unit_cost * lv.qty * 100) / 100 : null;
  }
  function prefillCost(tr) {
    var med = MEDS[tr.getAttribute('data-med')], cost = tr.querySelector('.f-cost');
    var last = lastCostFor(med, tr.querySelector('.f-unit').value);
    if (last !== null && (cost.value === '' || tr.getAttribute('data-auto') === '1')) { cost.value = fmt(last); tr.setAttribute('data-auto', '1'); }
    costHint(tr);
  }
  function costHint(tr) {
    var med = MEDS[tr.getAttribute('data-med')], cost = tr.querySelector('.f-cost'), hint = tr.querySelector('.cost-hint');
    var unitSel = tr.querySelector('.f-unit'), unitName = unitSel.options[unitSel.selectedIndex].text;
    var last = lastCostFor(med, unitSel.value), lc = med && med.last_cost;
    cost.classList.remove('low'); hint.classList.remove('warn');
    if (last === null) { hint.textContent = 'أول مرة تتسجّل للصنف ده (مفيش سعر قديم)'; return; }
    var info = lc.source === 'avg'
      ? 'متوسط التكلفة المسجّل: ' + fmt(last) + ' / ' + unitName
      : 'آخر سعر: ' + fmt(last) + ' / ' + unitName + (lc.discount_percent > 0 ? ' (خصم ' + lc.discount_percent + '%)' : '') + (lc.date ? ' — ' + lc.date : '') + (lc.supplier ? ' — ' + lc.supplier : '');
    var now = parseFloat(cost.value);
    if (!isNaN(now) && cost.value !== '' && now < last - 0.005) {
      var diff = last - now;
      cost.classList.add('low'); hint.classList.add('warn');
      hint.textContent = '⚠ تحذير: السعر أقل من المسجّل بـ ' + fmt(diff) + ' ج (' + Math.round(diff / last * 100) + '%) — اتأكد إنه مش غلطة. ' + info;
    } else { hint.textContent = info; }
  }

  function rows() {
    return Array.prototype.map.call(tbody.querySelectorAll('tr'), function (tr) {
      return {
        _tr: tr, medicine_id: parseInt(tr.getAttribute('data-med'), 10), unit: tr.querySelector('.f-unit').value,
        quantity: tr.querySelector('.f-qty').value, cost: tr.querySelector('.f-cost').value, discount_percent: tr.querySelector('.f-disc').value || '0',
        expiry_date: tr.querySelector('.f-exp').value, batch_number: tr.querySelector('.f-batch').value.trim() || null
      };
    });
  }

  function refresh() {
    var d = Math.min(Math.max(parseFloat($('disc').value) || 0, 0), 100), sub = 0, net = 0;
    rows().forEach(function (r) {
      var ld = Math.min(Math.max(parseFloat(r.discount_percent) || 0, 0), 100);
      var gross = (parseFloat(r.quantity) || 0) * (parseFloat(r.cost) || 0);
      var line = gross * (1 - ld / 100) * (1 - d / 100);
      sub += gross; net += line;
      r._tr.querySelector('.f-line').textContent = line.toFixed(2);
    });
    var paid = parseFloat($('paid').value) || 0;
    $('subtotal').textContent = sub.toFixed(2); $('discAmt').textContent = (sub - net).toFixed(2);
    $('grand').textContent = net.toFixed(2); $('remain').textContent = Math.max(net - paid, 0).toFixed(2);
    $('emptyLines').style.display = tbody.children.length ? 'none' : '';
  }
  tbody.addEventListener('input', function (e) {
    var tr = e.target.closest('tr'); if (!tr) return;
    if (e.target.classList.contains('f-cost')) { tr.setAttribute('data-auto', '0'); costHint(tr); }
    else if (e.target.classList.contains('f-unit')) prefillCost(tr);
    refresh();
  });
  tbody.addEventListener('click', function (e) { if (e.target.classList.contains('f-del')) { e.target.closest('tr').remove(); refresh(); } });
  $('disc').addEventListener('input', refresh);
  $('paid').addEventListener('input', refresh);

  // ---------- قارئ الباركود: يضيف الصنف مباشرة (ولو اتمسح تاني نفس الصنف يزوّد الكمية) ----------
  window.onBarcodeScan = function (code) {
    if ($('camModal').style.display === 'flex') return true;
    if ($('itemModal').style.display === 'flex') { handleModalBarcode(code); return true; }
    getJson('/purchases/api/medicines?q=' + encodeURIComponent(code)).then(function (d) {
      if (d.exact && d.results.length) {
        var m = d.results[0], existing = tbody.querySelector('tr[data-med="' + m.id + '"]');
        if (existing && !existing.querySelector('.f-exp').value) {
          var q = existing.querySelector('.f-qty'); q.value = (parseInt(q.value, 10) || 0) + 1; refresh();
        } else { addLine(m); }
        msg('تمت إضافة: ' + m.name, 'ok');
      } else { itemSearch.value = code; itemSearch.dispatchEvent(new Event('input')); msg('الباركود/السيريال ' + code + ' غير مسجل — اختار الصنف يدويًا أو أضفه من صفحة الأصناف', 'err'); }
    }).catch(function () { msg('حدث خطأ في الاتصال بالسيرفر', 'err'); });
    return true;
  };

  // ---------- مودال المورد / الصنف الجديد (من غير ما نسيب الصفحة) ----------
  function postJson(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.error || 'حصل خطأ'); return d; }); });
  }
  function openModal(id) { $(id).style.display = 'flex'; }
  function closeModal(id) { $(id).style.display = 'none'; if (id === 'camModal') stopCam(); }
  document.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', function () { closeModal(b.getAttribute('data-close')); }); });
  document.querySelectorAll('.modal-bg').forEach(function (bg) { bg.addEventListener('mousedown', function (e) { if (e.target === bg) closeModal(bg.id); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('.modal-bg').forEach(function (bg) { closeModal(bg.id); }); });

  function openSupModal(name) {
    ['sm_company', 'sm_rep', 'sm_phone'].forEach(function (i) { $(i).value = ''; });
    $('sm_name').value = name || ''; $('sm_err').textContent = ''; supList.style.display = 'none';
    openModal('supModal'); $('sm_name').focus();
  }
  $('newSupBtn').addEventListener('click', function () { openSupModal(supSearch.value.trim()); });
  $('sm_save').addEventListener('click', function () {
    $('sm_err').textContent = '';
    postJson('/purchases/api/suppliers/add', { name: $('sm_name').value, company: $('sm_company').value, rep_name: $('sm_rep').value, phone: $('sm_phone').value })
      .then(function (d) { closeModal('supModal'); selectSupplier(d.supplier); })
      .catch(function (e) { $('sm_err').textContent = e.message; });
  });

  var FORMS = null;
  function syncFormFields() {
    var f = FORMS && FORMS.filter(function (x) { return x.key === $('im_form').value; })[0];
    $('im_upsBox').style.display = !f || f.counted ? '' : 'none';
    $('im_spbBox').style.display = !f || (f.counted && f.strip) ? '' : 'none';
    $('im_upsBox').querySelector('label').textContent = f && f.strip ? 'عدد الحبات في الشريط' : 'عدد الوحدات في العلبة';
  }
  // قارئ الباركود جاهز أول ما المودال يفتح: الخانة متفوكسة والسكانر بيكتب فيها، وبعد المسح المؤشر بينزل لاسم الصنف
  function scanReady() { $('im_scan').textContent = '📡 جاهز للمسح — اسكن الباركود دلوقتي (أو اضغط 📷 للكاميرا)'; $('im_scan').className = 'scan-msg ok'; }
  function handleModalBarcode(code) {
    code = String(code || '').trim(); if (!code) return;
    $('im_barcode').value = code; $('im_scan').className = 'scan-msg'; $('im_scan').textContent = 'جاري التحقق من الباركود...';
    getJson('/purchases/api/medicines?q=' + encodeURIComponent(code)).then(function (d) {
      if (d.exact && d.results.length) {
        var m = d.results[0];
        $('im_barcode').value = '';
        $('im_scan').className = 'scan-msg err';
        $('im_scan').innerHTML = '⚠ الباركود ' + esc(code) + ' مسجّل بالفعل للصنف «' + esc(m.name) + '» <button type="button" class="btn-ghost-sm" id="im_useExisting">إضافته للطلبية</button>';
        $('im_useExisting').addEventListener('click', function () { closeModal('itemModal'); addLine(m); itemSearch.value = ''; msg('تمت إضافة: ' + m.name, 'ok'); });
      } else {
        $('im_scan').className = 'scan-msg ok'; $('im_scan').textContent = '✔ تم مسح الباركود: ' + code;
        $('im_name').focus();
      }
    }).catch(function () { $('im_scan').className = 'scan-msg ok'; $('im_scan').textContent = 'تم مسح الباركود: ' + code; $('im_name').focus(); });
  }
  // كاميرا الموبايل/اللابتوب (المكتبة بتتحمّل أول ما تتطلب)
  var cam = null;
  function loadCamLib(cb) {
    if (window.Html5Qrcode) return cb();
    var s = document.createElement('script'); s.src = 'https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js'; s.onload = cb;
    s.onerror = function () { $('im_err').textContent = 'تعذّر تحميل مكتبة الكاميرا (تأكد من الإنترنت)'; };
    document.head.appendChild(s);
  }
  function startCam() {
    loadCamLib(function () {
      openModal('camModal');
      cam = new Html5Qrcode('camReader');
      cam.start({ facingMode: 'environment' }, { fps: 10, qrbox: { width: 260, height: 160 } }, function (text) { closeModal('camModal'); handleModalBarcode(text); }, function () {})
        .catch(function () { closeModal('camModal'); $('im_err').textContent = 'تعذّر فتح الكاميرا — اسمح بالصلاحيات'; });
    });
  }
  function stopCam() {
    if (!cam) return; var c = cam; cam = null;
    try { c.stop().then(function () { c.clear(); }).catch(function () {}); } catch (e) {}
  }
  $('im_cam').addEventListener('click', startCam);
  $('im_barcode').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); if ($('im_barcode').value.trim()) handleModalBarcode($('im_barcode').value); } });

  function openItemModal(name) {
    name = String(name || '').trim();
    var isCode = /^[0-9]{6,}$/.test(name);   // لو اللي اتكتب/اتمسح باركود (أرقام) نحطه في خانة الباركود مش الاسم
    ['im_barcode', 'im_serial', 'im_mfr', 'im_price', 'im_shortcut'].forEach(function (i) { $(i).value = ''; });
    $('im_ups').value = 1; $('im_spb').value = 1; $('im_name').value = isCode ? '' : name; $('im_err').textContent = ''; itemList.style.display = 'none';
    $('im_scan').textContent = ''; $('im_scan').className = 'scan-msg';
    var show = function () {
      openModal('itemModal');
      if (isCode) { handleModalBarcode(name); } else { $('im_barcode').focus(); scanReady(); }
    };
    if (FORMS) { show(); return; }
    getJson('/purchases/api/forms').then(function (d) {
      FORMS = d.forms;
      $('im_form').innerHTML = FORMS.map(function (f) { return '<option value="' + f.key + '">' + esc(f.label) + '</option>'; }).join('');
      $('im_form').value = 'tablet'; syncFormFields(); show();
    });
  }
  $('im_form').addEventListener('change', syncFormFields);
  $('newItemBtn').addEventListener('click', function () { openItemModal(itemSearch.value.trim()); });

  // توليد باركود داخلي عشوائي (EAN-13 بادئة 20)
  function ean13Check(d12) { var sum = 0; for (var i = 0; i < 12; i++) sum += parseInt(d12[i], 10) * (i % 2 === 0 ? 1 : 3); return (10 - (sum % 10)) % 10; }
  $('im_gen').addEventListener('click', function () {
    var d12 = ('20' + Date.now().toString().slice(-8) + Math.floor(10 + Math.random() * 90)).slice(0, 12);
    $('im_barcode').value = d12 + ean13Check(d12);
  });
  $('im_save').addEventListener('click', function () {
    $('im_err').textContent = '';
    postJson('/purchases/api/medicines/add', {
      name: $('im_name').value, barcode: $('im_barcode').value, form_kind: $('im_form').value, sale_price_box: $('im_price').value,
      units_per_strip: $('im_ups').value, strips_per_box: $('im_spb').value, manufacturer: $('im_mfr').value, serial_number: $('im_serial').value,
      shortcut_code: $('im_shortcut').value
    }).then(function (d) { closeModal('itemModal'); addLine(d.medicine); itemSearch.value = ''; msg('تمت إضافة الصنف الجديد: ' + d.medicine.name, 'ok'); })
      .catch(function (e) { $('im_err').textContent = e.message; });
  });

  $('piForm').addEventListener('submit', function (e) {
    var rs = rows();
    if (!$('supplierId').value) { e.preventDefault(); alert('اختار المورد الأول'); supSearch.focus(); return; }
    if (!rs.length) { e.preventDefault(); alert('أضف صنف واحد على الأقل'); return; }
    for (var i = 0; i < rs.length; i++) {
      if (!rs[i].expiry_date) { e.preventDefault(); alert('البند رقم ' + (i + 1) + ': تاريخ الصلاحية مطلوب'); return; }
      if (rs[i].cost === '') { e.preventDefault(); alert('البند رقم ' + (i + 1) + ': اكتب سعر الوحدة'); return; }
    }
    $('itemsJson').value = JSON.stringify(rs.map(function (r) { delete r._tr; return r; }));
    $('submitBtn').disabled = true;
  });
  // Enter جوه خانات الفورم مايبعتش الفورم بالغلط
  $('piForm').addEventListener('keydown', function (e) { if (e.key === 'Enter' && e.target.tagName === 'INPUT') e.preventDefault(); });
  refresh();
})();
</script>
<% } %>
</body>
</html>
