<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>فاتورة شراء جديدة - <%= shopName %></title>
  <%- include('partials/head') %>
  <style>
    .pi-lines td { padding: 6px 4px; vertical-align: top; }
    .pi-lines input, .pi-lines select { min-width: 0; width: 100%; }
    .pi-total { font-size: 20px; font-weight: 700; }
  </style>
</head>
<body>
  <% var active = 'purchases' %>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>فاتورة شراء جديدة</h1>
        <p>كل صنف بيدخل المخزون كتشغيلة بتاريخ صلاحيته، والمبلغ المتبقي بيتسجل مديونية على المورد</p>
      </div>
      <a href="/purchases" class="btn-ghost-sm">← رجوع</a>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form action="/purchases/create" method="POST" id="piForm">
      <input type="hidden" name="idempotency_key" value="<%= idempotencyKey %>">
      <input type="hidden" name="items_json" id="itemsJson">

      <div class="card">
        <div class="form-grid">
          <div class="field"><label>المورد *</label>
            <select name="supplier_id" id="supplierSel" required>
              <option value="">-- اختر المورد --</option>
              <% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= String(form.supplier_id || '') === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %>
            </select></div>
          <div class="field"><label>رقم فاتورة المورد</label><input type="text" name="invoice_number" maxlength="80" value="<%= form.invoice_number || '' %>"></div>
          <div class="field"><label>تاريخ الفاتورة</label><input type="date" name="invoice_date" value="<%= form.invoice_date || today %>"></div>
          <div class="field"><label>ميعاد الاستحقاق (للآجل)</label><input type="date" name="due_date" value="<%= form.due_date || '' %>"></div>
          <div class="field"><label>نسبة الخصم على الطلبية %</label><input type="number" name="discount_percent" id="disc" min="0" max="100" step="0.01" value="<%= form.discount_percent || '0' %>"></div>
        </div>
        <div id="supBalance" style="display:none; margin-top:12px; padding:10px 12px; border-radius:10px; border:1px dashed var(--accent); background:var(--accent-soft);"></div>
      </div>

      <div class="card">
        <h2>الأصناف</h2>
        <datalist id="medList">
          <% medicines.forEach(m => { %><option value="<%= m.name %> #<%= m.id %>"><% if (m.barcode) { %><%= m.barcode %><% } %></option><% }) %>
        </datalist>
        <table class="pi-lines">
          <thead><tr><th style="width:26%">الصنف</th><th>الوحدة</th><th>الكمية</th><th>سعر الوحدة</th><th>خصم الصنف %</th><th>الصلاحية</th><th>رقم التشغيلة</th><th>الإجمالي</th><th></th></tr></thead>
          <tbody id="lines"></tbody>
        </table>
        <button type="button" class="btn-outline btn-sm" id="addLine">➕ إضافة صنف</button>
        <p style="color:var(--text-muted); font-size:13px;">السعر هو سعر الوحدة المختارة (علبة / شريط / حبة)، والنظام بيحوّله لتكلفة الحبة.</p>
      </div>

      <div class="card">
        <div class="form-grid">
          <div class="field"><label>إجمالي الفاتورة</label><div class="pi-total mono"><span id="grand">0.00</span> ج.م</div></div>
          <div class="field"><label>المدفوع الآن (0 = آجل)</label><input type="number" step="0.01" min="0" name="paid_amount" id="paid" value="<%= form.paid_amount || '0' %>"></div>
          <div class="field"><label>طريقة الدفع</label>
            <select name="method"><option value="cash">نقدي</option><option value="bank">تحويل بنكي</option><option value="other">أخرى</option></select></div>
          <div class="field"><label>المتبقي على المورد</label><div class="pi-total mono"><span id="remain">0.00</span> ج.م</div></div>
        </div>
        <div id="paidNote" style="display:none; margin-bottom:12px; padding:10px 12px; border-radius:10px;"></div>
        <div class="field"><label>ملاحظات</label><input type="text" name="notes" maxlength="500" value="<%= form.notes || '' %>"></div>
        <button type="submit" class="btn" id="submitBtn">تسجيل الفاتورة واستلام البضاعة</button>
      </div>
    </form>
  </div>

<script>
(function () {
  var MEDS = <%- JSON.stringify(medicines.map(function (m) { return { id: m.id, name: m.name, ups: m.ups, spb: m.spb }; })).replace(/</g, '\\u003c') %>;
  var BY_ID = {}; MEDS.forEach(function (m) { BY_ID[m.id] = m; });
  var saved = <%- JSON.stringify((function () { try { return JSON.parse(form.items_json || '[]'); } catch (e) { return []; } })()).replace(/</g, '\\u003c') %>;
  var tbody = document.getElementById('lines');

  function idFromText(t) { var m = /#(\d+)\s*$/.exec(t || ''); return m ? parseInt(m[1], 10) : null; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function addLine(v) {
    v = v || {};
    var tr = document.createElement('tr');
    var med = v.medicine_id ? BY_ID[v.medicine_id] : null;
    tr.innerHTML =
      '<td data-label="الصنف"><input type="text" list="medList" class="f-med" placeholder="اكتب اسم الصنف..." value="' + esc(med ? med.name + ' #' + med.id : '') + '"></td>' +
      '<td data-label="الوحدة"><select class="f-unit"><option value="box">علبة</option><option value="strip">شريط</option><option value="unit">حبة</option></select></td>' +
      '<td data-label="الكمية"><input type="number" min="1" step="1" class="f-qty" value="' + esc(v.quantity || '') + '"></td>' +
      '<td data-label="سعر الوحدة"><input type="number" min="0" step="0.01" class="f-cost" value="' + esc(v.cost == null ? '' : v.cost) + '"></td>' +
      '<td data-label="خصم الصنف %"><input type="number" min="0" max="100" step="0.01" class="f-disc" value="' + esc(v.discount_percent == null ? 0 : v.discount_percent) + '"></td>' +
      '<td data-label="الصلاحية"><input type="date" class="f-exp" value="' + esc(v.expiry_date || '') + '"></td>' +
      '<td data-label="رقم التشغيلة"><input type="text" class="f-batch" maxlength="80" value="' + esc(v.batch_number || '') + '"></td>' +
      '<td class="mono f-line" data-label="الإجمالي">0.00</td>' +
      '<td><button type="button" class="btn-ghost-sm f-del" title="حذف">✕</button></td>';
    tr.querySelector('.f-unit').value = v.unit || 'box';
    tbody.appendChild(tr);
    return tr;
  }

  function read() {
    var rows = [];
    tbody.querySelectorAll('tr').forEach(function (tr) {
      rows.push({
        medicine_id: idFromText(tr.querySelector('.f-med').value),
        unit: tr.querySelector('.f-unit').value,
        quantity: tr.querySelector('.f-qty').value,
        cost: tr.querySelector('.f-cost').value,
        discount_percent: tr.querySelector('.f-disc').value || '0',
        expiry_date: tr.querySelector('.f-exp').value,
        batch_number: tr.querySelector('.f-batch').value.trim() || null,
        _tr: tr
      });
    });
    return rows;
  }

  function recalc() {
    var total = 0;
    var d = Math.min(Math.max(parseFloat(document.getElementById('disc').value) || 0, 0), 100);
    read().forEach(function (r) {
      var ld = Math.min(Math.max(parseFloat(r.discount_percent) || 0, 0), 100);
      var line = (parseFloat(r.quantity) || 0) * (parseFloat(r.cost) || 0) * (1 - ld / 100) * (1 - d / 100);
      r._tr.querySelector('.f-line').textContent = line.toFixed(2);
      total += line;
    });
    document.getElementById('grand').textContent = total.toFixed(2);
    var paid = parseFloat(document.getElementById('paid').value) || 0;
    document.getElementById('remain').textContent = Math.max(total - paid, 0).toFixed(2);
    lastTotal = total;
    showPaidNote(total, paid);
  }

  // ---------- مديونية المورد القديمة + سداد الزيادة منها ----------
  var lastTotal = 0, supBalance = 0, supInvoices = [], supReq = 0;
  function money(n) { return (Math.round(n * 100) / 100).toFixed(2); }
  function showPaidNote(total, paid) {
    var box = document.getElementById('paidNote');
    var extra = Math.round((paid - total) * 100) / 100;
    if (extra <= 0.004) { box.style.display = 'none'; return; }
    box.style.display = 'block';
    if (!document.getElementById('supplierSel').value) {
      box.style.cssText = 'display:block; margin-bottom:12px; padding:10px 12px; border-radius:10px; background:rgba(220,53,69,.12); color:var(--danger);';
      box.textContent = 'المدفوع أكبر من إجمالي الفاتورة — اختار المورد الأول.';
    } else if (extra > supBalance + 0.004) {
      box.style.cssText = 'display:block; margin-bottom:12px; padding:10px 12px; border-radius:10px; background:rgba(220,53,69,.12); color:var(--danger);';
      box.textContent = 'المدفوع أكبر من إجمالي الفاتورة (' + money(total) + ') بمبلغ ' + money(extra) + '، والمورد مديونيته القديمة ' + money(supBalance) + ' بس — قلّل المدفوع.';
    } else {
      box.style.cssText = 'display:block; margin-bottom:12px; padding:10px 12px; border-radius:10px; background:var(--accent-soft);';
      box.textContent = 'هيتسجل: ' + money(Math.min(total, paid)) + ' ج.م على الفاتورة دي، والزيادة ' + money(extra) + ' ج.م هتتخصم من فواتير المورد القديمة (الأقدم أولًا). هيفضل له ' + money(supBalance - extra) + ' ج.م.';
    }
  }
  function loadSupplier() {
    var id = document.getElementById('supplierSel').value, box = document.getElementById('supBalance');
    supBalance = 0; supInvoices = [];
    if (!id) { box.style.display = 'none'; recalc(); return; }
    var req = ++supReq;
    fetch('/purchases/api/supplier-balance?id=' + encodeURIComponent(id), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (req !== supReq) return;
        supBalance = Number(d.balance) || 0; supInvoices = d.invoices || [];
        box.style.display = 'block';
        if (!supBalance) { box.textContent = 'المورد ده مفيش له مديونية قديمة عندك.'; recalc(); return; }
        box.innerHTML = '<b>المورد له عندك ' + money(supBalance) + ' ج.م</b> (' + supInvoices.length + ' فاتورة غير مسددة). ' +
          'لو دفعت أكتر من إجمالي الفاتورة الجديدة، الزيادة بتتخصم منها تلقائيًا.' +
          '<div style="margin-top:6px; font-size:13px; color:var(--text-muted);">' +
          supInvoices.slice(0, 5).map(function (i) { return '#' + i.id + (i.invoice_number ? ' (' + esc(i.invoice_number) + ')' : '') + ' — ' + esc(i.invoice_date) + ' — متبقي ' + money(Number(i.remaining)); }).join('<br>') +
          (supInvoices.length > 5 ? '<br>…' : '') + '</div>';
        recalc();
      })
      .catch(function () { box.style.display = 'none'; });
  }
  document.getElementById('supplierSel').addEventListener('change', loadSupplier);

  tbody.addEventListener('input', recalc);
  tbody.addEventListener('click', function (e) {
    if (e.target.classList.contains('f-del')) {
      if (tbody.children.length > 1) { e.target.closest('tr').remove(); recalc(); }
    }
  });
  document.getElementById('paid').addEventListener('input', recalc);
  document.getElementById('disc').addEventListener('input', recalc);
  document.getElementById('addLine').addEventListener('click', function () { addLine().querySelector('.f-med').focus(); });

  document.getElementById('piForm').addEventListener('submit', function (e) {
    var rows = read();
    for (var i = 0; i < rows.length; i++) {
      if (!rows[i].medicine_id) { e.preventDefault(); alert('البند رقم ' + (i + 1) + ': اختار الصنف من القائمة المقترحة'); return; }
    }
    document.getElementById('itemsJson').value = JSON.stringify(rows.map(function (r) { delete r._tr; return r; }));
    document.getElementById('submitBtn').disabled = true; // منع الضغط المزدوج
  });

  // قارئ الباركود: يضيف الصنف مباشرة (باركود أو سيريال)
  window.onBarcodeScan = function (code) {
    fetch('/purchases/api/medicines?q=' + encodeURIComponent(code), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
      if (!(d.exact && d.results.length)) { alert('الباركود/السيريال ' + code + ' غير مسجل'); return; }
      var m = d.results[0]; BY_ID[m.id] = BY_ID[m.id] || { id: m.id, name: m.name, ups: m.ups, spb: m.spb };
      var trs = tbody.querySelectorAll('tr'), last = trs[trs.length - 1];
      if (last && !last.querySelector('.f-med').value) { last.querySelector('.f-med').value = m.name + ' #' + m.id; last.querySelector('.f-unit').value = m.default_unit; last.querySelector('.f-qty').focus(); }
      else { var tr = addLine({ medicine_id: m.id, unit: m.default_unit }); tr.querySelector('.f-qty').focus(); }
      recalc();
    });
    return true;
  };

  (saved.length ? saved : [{}]).forEach(addLine);
  recalc();
  loadSupplier();
})();
</script>
</body>
</html>
