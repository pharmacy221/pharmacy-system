<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>تقرير <%= employee.name %> - <%= shopName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="no-print"><% var active = 'payroll' %><%- include('partials/nav') %></div>
  <div class="page">
    <div class="receipt-paper" style="max-width:700px;">
      <div class="r-top">
        <h2><%= shop.pharmacy_name || shopName %></h2>
        <div>تقرير شامل — <%= employee.name %></div>
        <div style="font-size:12px; color:var(--text-muted);">
          الفترة من <%= new Date(from).toLocaleDateString('ar-EG') %> إلى <%= new Date(to).toLocaleDateString('ar-EG') %>
        </div>
      </div>

      <div class="section-title">الحضور والانصراف</div>
      <table class="cart-table">
        <thead><tr><th>التاريخ</th><th>الحالة</th><th>حضور</th><th>انصراف</th></tr></thead>
        <tbody>
          <% const statusLabels = { present:'حاضر', late:'متأخر', leave:'إجازة', absent:'غائب' }; %>
          <% attendance.forEach(a => { %>
            <tr>
              <td><%= new Date(a.attendance_date).toLocaleDateString('ar-EG') %></td>
              <td><%= statusLabels[a.status] || a.status %></td>
              <td class="mono"><%= a.check_in || '-' %></td>
              <td class="mono"><%= a.check_out || '-' %></td>
            </tr>
          <% }) %>
          <% if (attendance.length === 0) { %><tr><td colspan="4" class="empty-state">مفيش سجل حضور</td></tr><% } %>
        </tbody>
      </table>

      <div class="section-title" style="margin-top:18px;">السلف</div>
      <table class="cart-table">
        <thead><tr><th>التاريخ</th><th>السبب</th><th>القيمة</th><th>الحالة</th></tr></thead>
        <tbody>
          <% advancesList.forEach(a => { %>
            <tr>
              <td><%= new Date(a.advance_date).toLocaleDateString('ar-EG') %></td>
              <td><%= a.reason || '-' %></td>
              <td class="mono"><%= Number(a.amount).toFixed(2) %></td>
              <td><%= a.settled ? 'مخصومة' : 'مستحقة' %></td>
            </tr>
          <% }) %>
          <% if (advancesList.length === 0) { %><tr><td colspan="4" class="empty-state">مفيش سلف في الفترة دي</td></tr><% } %>
        </tbody>
      </table>

      <div class="section-title" style="margin-top:18px;">الرواتب المقبوضة</div>
      <table class="cart-table">
        <thead><tr><th>الفترة</th><th>الصافي المدفوع</th></tr></thead>
        <tbody>
          <% paymentsList.forEach(p => { %>
            <tr>
              <td><%= new Date(p.period_start).toLocaleDateString('ar-EG') %> - <%= new Date(p.period_end).toLocaleDateString('ar-EG') %></td>
              <td class="mono"><%= Number(p.net_paid).toFixed(2) %></td>
            </tr>
          <% }) %>
          <% if (paymentsList.length === 0) { %><tr><td colspan="2" class="empty-state">مفيش رواتب مقبوضة في الفترة دي</td></tr><% } %>
        </tbody>
      </table>

      <div class="receipt-actions no-print">
        <button class="btn" onclick="window.print()">طباعة</button>
        <a href="/payroll/<%= employee.id %>" class="btn-outline">رجوع</a>
      </div>
    </div>
  </div>
</body>
</html>
