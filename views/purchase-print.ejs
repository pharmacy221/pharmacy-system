<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>فاتورة طلبية #<%= invoice.id %> - <%= shopName %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif; color: #111; margin: 0; padding: 16px; background: #f1f5f9; }
    .sheet { max-width: 800px; margin: 0 auto; background: #fff; padding: 24px; border: 1px solid #e2e8f0; border-radius: 8px; }
    .toolbar { max-width: 800px; margin: 0 auto 12px; display: flex; gap: 8px; }
    .toolbar button, .toolbar a { padding: 8px 16px; border-radius: 6px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; font: inherit; text-decoration: none; color: #111; }
    .toolbar .primary { background: #0f766e; color: #fff; border-color: #0f766e; }
    h1 { margin: 0; font-size: 22px; }
    .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 10px; margin-bottom: 12px; }
    .head .sub { color: #475569; font-size: 13px; margin-top: 2px; }
    .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; font-size: 14px; margin-bottom: 14px; }
    .meta b { color: #475569; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { border: 1px solid #cbd5e1; padding: 6px 8px; text-align: right; vertical-align: top; }
    th { background: #f1f5f9; }
    .num { font-family: monospace; direction: ltr; text-align: center; white-space: nowrap; }
    .small { color: #64748b; font-size: 11px; }
    .totals { margin: 14px 0 0 auto; width: 320px; font-size: 14px; }
    .totals div { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px dashed #cbd5e1; }
    .totals .grand { font-weight: 700; font-size: 17px; border-bottom: 2px solid #111; }
    .cancelled { color: #b91c1c; font-weight: 700; border: 2px solid #b91c1c; padding: 2px 10px; border-radius: 6px; display: inline-block; }
    .sign { display: flex; justify-content: space-between; margin-top: 36px; font-size: 13px; color: #475569; }
    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none; }
      .sheet { border: none; padding: 0; max-width: none; }
      tr { page-break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="primary" onclick="window.print()">🖨️ طباعة</button>
    <a href="/purchases/<%= invoice.id %>">← تفاصيل الفاتورة</a>
    <a href="/products/batches">← التشغيلات</a>
  </div>

  <div class="sheet">
    <div class="head">
      <div>
        <h1><%= shopName %></h1>
        <div class="sub">فاتورة استلام طلبية من مورد</div>
      </div>
      <div style="text-align:left">
        <div style="font-size:18px; font-weight:700">#<%= invoice.id %></div>
        <% if (invoice.status === 'cancelled') { %><div class="cancelled">ملغاة</div><% } %>
      </div>
    </div>

    <div class="meta">
      <div><b>المورد:</b> <%= invoice.supplier_name %></div>
      <div><b>التاريخ:</b> <%= new Date(invoice.invoice_date).toLocaleDateString('ar-EG') %></div>
      <% if (invoice.supplier_company) { %><div><b>الشركة:</b> <%= invoice.supplier_company %></div><% } %>
      <div><b>رقم فاتورة المورد:</b> <%= invoice.invoice_number || '—' %></div>
      <% if (invoice.rep_name) { %><div><b>المندوب:</b> <%= invoice.rep_name %></div><% } %>
      <% if (invoice.due_date) { %><div><b>الاستحقاق:</b> <%= new Date(invoice.due_date).toLocaleDateString('ar-EG') %></div><% } %>
      <% if (invoice.supplier_phone) { %><div><b>تليفون المورد:</b> <span class="num"><%= invoice.supplier_phone %></span></div><% } %>
      <div><b>استلمها:</b> <%= invoice.created_by_name || '—' %></div>
    </div>

    <table>
      <thead>
        <tr><th>#</th><th>الصنف</th><th>التشغيلة</th><th>الصلاحية</th><th>الكمية</th><th>سعر الوحدة</th><th>خصم الصنف</th><th>الإجمالي</th></tr>
      </thead>
      <tbody>
        <% const disc = Number(invoice.discount_percent || 0); %>
        <% items.forEach((i, n) => { %>
          <tr>
            <td class="num"><%= n + 1 %></td>
            <td>
              <%= i.medicine_name %>
              <% if (i.serial_number || i.barcode) { %><div class="small"><% if (i.serial_number) { %>سيريال: <%= i.serial_number %><% } %><% if (i.serial_number && i.barcode) { %> — <% } %><% if (i.barcode) { %>باركود: <%= i.barcode %><% } %></div><% } %>
            </td>
            <td class="num"><%= i.batch_number || '—' %></td>
            <td class="num"><%= new Date(i.expiry_date).toLocaleDateString('ar-EG') %></td>
            <td class="num"><%= i.entry_quantity %> <%= unitLabel(i, i.entry_unit) %></td>
            <td class="num"><%= Number(i.entry_cost).toFixed(2) %></td>
            <td class="num"><%= Number(i.discount_percent) > 0 ? Number(i.discount_percent) + '%' : '—' %></td>
            <td class="num"><%= Number(i.line_total).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="totals">
      <div><span>الإجمالي قبل الخصم</span><span class="num"><%= Number(invoice.subtotal_amount != null ? invoice.subtotal_amount : invoice.total_amount).toFixed(2) %> ج.م</span></div>
      <% if (disc > 0) { %>
        <div><span>خصم إضافي على الطلبية</span><span class="num"><%= disc %>%</span></div>
      <% } %>
      <% if (disc > 0 || items.some(function (x) { return Number(x.discount_percent) > 0; })) { %>
        <div><span>إجمالي الخصم</span><span class="num">− <%= (Number(invoice.subtotal_amount != null ? invoice.subtotal_amount : invoice.total_amount) - Number(invoice.total_amount)).toFixed(2) %> ج.م</span></div>
      <% } %>
      <div class="grand"><span>الصافي</span><span class="num"><%= Number(invoice.total_amount).toFixed(2) %> ج.م</span></div>
      <div><span>المدفوع</span><span class="num"><%= Number(invoice.paid_amount).toFixed(2) %> ج.م</span></div>
      <div><span>المتبقي على المورد</span><span class="num"><%= invoice.status === 'cancelled' ? '—' : Number(invoice.remaining).toFixed(2) + ' ج.م' %></span></div>
    </div>

    <% if (invoice.notes) { %><p style="font-size:13px; margin-top:14px;"><b>ملاحظات:</b> <%= invoice.notes %></p><% } %>

    <div class="sign"><span>توقيع المستلم: ____________</span><span>توقيع المندوب: ____________</span></div>
  </div>
</body>
</html>
