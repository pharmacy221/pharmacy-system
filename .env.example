# .env.example
# انسخ الملف ده باسم .env واملأ القيم الحقيقية

# Connection String بتاع Supabase
# هتلاقيه في: Supabase Dashboard > Project Settings > Database > Connection string > URI
# (اختار "Session pooling" أو "Transaction pooling" حسب استضافتك، أو الاتصال المباشر لو مش عندك مشاكل IPv6)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# أي نص عشوائي طويل لتشفير الجلسة
SESSION_SECRET=change-this-to-a-long-random-string

# البورت اللي السيرفر هيشتغل عليه محليًا
PORT=3000

# غيّرها لـ production لما تشغّل السيرفر خلف HTTPS حقيقي
NODE_ENV=development


# (اختياري) لملفات src/ الخاصة بوضع الأوفلاين التجريبي — مفيش مفاتيح بتتكتب في الكود
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=
